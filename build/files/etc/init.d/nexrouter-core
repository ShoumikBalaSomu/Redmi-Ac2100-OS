#!/bin/sh /etc/rc.common
# ===========================================================================
# nexrouter-core (v3.3) — Stock Silicon Inter-Chip Optimizer
# ===========================================================================
# Pushes every software-possible optimization across the PRESENT stock chips
# on the Xiaomi Redmi Router AC2100 (zero physical soldering required):
#
#   1. Stock ESMT M15T1G1664A (128 MiB DDR3) -> ~200 MiB Effective RAM:
#      Configures a 64 MiB compressed ZRAM block device in RAM (LZ4/LZO-RLE
#      across 4 MIPS VPEs, page-cluster=0, swappiness=100).
#   2. Stock MT7621AT (2C/4T MIPS 1004Kc) -> 4-VPE Interrupt & NAPI Split:
#      - VPE0 (0x1): MT7621 Frame Engine (GMAC0 LAN DSA + GMAC1 WAN)
#      - VPE1 (0x2): MT7603EN 2.4 GHz PCIe1 Interrupts
#      - VPE2 (0x4): MT7615N 5 GHz PCIe0 Interrupts
#      - VPE3 (0x8): Threaded NAPI RX Poll & RPS/XPS SoftIRQs
#   3. Stock 2x Qorvo QPF4200 (+5V Wi-Fi 6 FEMs on 2.4 GHz) High-Gain Unlock:
#      Programs MT7603EN AGC/LNA and PA registers so the external QPF4200 FEMs
#      deliver full 15.5 dB RX LNA gain (2.1 dB NF) and -98 dBm wall sensitivity.
#   4. Stock MT7615N + MT7530 + MT7621 PPE Direct Flowtable Fastpath:
#      Verifies nftables hardware flowtable offloading across WAN, LAN, and Wi-Fi.
# ===========================================================================

START=98
STOP=10

VPE_COUNT="$(grep -c '^processor' /proc/cpuinfo 2>/dev/null)"
[ "${VPE_COUNT:-0}" -ge 2 ] 2>/dev/null || VPE_COUNT=4

log() { logger -t nexrouter-core -- "$*"; }

# 1. ZRAM Virtual Memory Multiplier for Stock 128 MiB DDR3 (ESMT M15T1G1664A)
configure_zram_virtual_ram() {
	local zram_en
	zram_en="$(uci -q get nexrouter.core.zram_boost 2>/dev/null || echo 1)"
	[ "$zram_en" = "1" ] || return 0

	# Tune VM for zero-latency RAM compression (page-cluster=0 = single-page I/O)
	[ -w /proc/sys/vm/page-cluster ] && printf '0' > /proc/sys/vm/page-cluster 2>/dev/null || true
	[ -w /proc/sys/vm/swappiness ] && printf '100' > /proc/sys/vm/swappiness 2>/dev/null || true

	# If /dev/zram0 exists and is not yet active in /proc/swaps, initialize 64 MiB ZRAM
	if [ -b /dev/zram0 ] && ! grep -q '/dev/zram0' /proc/swaps 2>/dev/null; then
		[ -w /sys/block/zram0/max_comp_streams ] && printf '%s' "$VPE_COUNT" > /sys/block/zram0/max_comp_streams 2>/dev/null || true
		if [ -w /sys/block/zram0/comp_algorithm ]; then
			for alg in lz4 lzo-rle lzo zstd; do
				if grep -q "$alg" /sys/block/zram0/comp_algorithm 2>/dev/null; then
					printf '%s' "$alg" > /sys/block/zram0/comp_algorithm 2>/dev/null && break
				fi
			done
		fi
		printf '%s' "$((64 * 1024 * 1024))" > /sys/block/zram0/disksize 2>/dev/null || true
		mkswap /dev/zram0 >/dev/null 2>&1 && swapon -p 100 /dev/zram0 2>/dev/null || true
		log "ZRAM virtual RAM multiplier active (64 MiB compressed pool on stock 128 MiB DDR3)"
	fi
}

set_irq_mask() {
	local mask="$1"; shift
	local irq
	for irq in "$@"; do
		[ -w "/proc/irq/$irq/smp_affinity" ] || continue
		printf '%s' "$mask" > "/proc/irq/$irq/smp_affinity" 2>/dev/null || true
	done
}

# 2. Dynamic IRQ Discovery & 4-VPE Partitioning
configure_irqs() {
	local irq_eth="" irq_2g="" irq_5g="" irq_pcie=""
	local line num name

	while read -r line; do
		num="${line%%:*}"
		num="$(printf '%s' "$num" | tr -d ' ')"
		case "$num" in ''|*[!0-9]*) continue ;; esac
		name="$(printf '%s' "$line" | awk '{print $NF}')"
		case "$name" in
			*1e100000.ethernet*|*mtk_soc_eth*|*fe100000*|eth0*|gsw*)
				irq_eth="$irq_eth $num" ;;
			*mt7603*|*0000:02:00.0*|*ra0*)
				irq_2g="$irq_2g $num" ;;
			*mt7615*|*0000:01:00.0*|*rai0*)
				irq_5g="$irq_5g $num" ;;
			*mt76*|*1e140000.pcie*|*pcie*)
				irq_pcie="$irq_pcie $num" ;;
		esac
	done < /proc/interrupts

	if [ "$VPE_COUNT" -ge 4 ]; then
		[ -n "$irq_eth" ]  && set_irq_mask 1 $irq_eth
		[ -n "$irq_2g" ]   && set_irq_mask 2 $irq_2g
		[ -n "$irq_5g" ]   && set_irq_mask 4 $irq_5g
		[ -z "$irq_5g" ] && [ -n "$irq_pcie" ] && set_irq_mask 4 $irq_pcie
		log "IRQ affinity (4-VPE): Ethernet($irq_eth)->VPE0, 2.4G($irq_2g)->VPE1, 5G($irq_5g $irq_pcie)->VPE2"
	else
		[ -n "$irq_eth" ]  && set_irq_mask 1 $irq_eth
		[ -n "$irq_2g" ]   && set_irq_mask 2 $irq_2g
		[ -n "$irq_5g" ]   && set_irq_mask 2 $irq_5g
		[ -n "$irq_pcie" ] && set_irq_mask 2 $irq_pcie
		log "IRQ affinity (2-VPE): Ethernet->VPE0, Radios->VPE1"
	fi
}

# 3. Threaded NAPI & Receive/Transmit Packet Steering (RPS/XPS)
configure_napi_and_rps() {
	local threaded_en netdev d rps_mask_wired rps_mask_wifi
	threaded_en="$(uci -q get nexrouter.core.threaded_napi 2>/dev/null || echo 1)"

	if [ "$VPE_COUNT" -ge 4 ]; then
		rps_mask_wired="a"
		rps_mask_wifi="c"
	else
		rps_mask_wired="3"
		rps_mask_wifi="3"
	fi

	[ -w /proc/sys/net/core/rps_sock_flow_entries ] && \
		printf '16384' > /proc/sys/net/core/rps_sock_flow_entries 2>/dev/null

	for netdev in /sys/class/net/*; do
		d="$(basename "$netdev")"
		case "$d" in lo) continue ;; esac

		if [ "$threaded_en" = "1" ] && [ -w "$netdev/threaded" ]; then
			case "$d" in
				eth*|wan|lan*|phy*-ap*|wlan*|ra*|rai*)
					printf '1' > "$netdev/threaded" 2>/dev/null || true ;;
			esac
		fi

		if [ -w "$netdev/queues/rx-0/rps_cpus" ]; then
			case "$d" in
				phy*-ap*|wlan*|ra*|rai*)
					printf '%s' "$rps_mask_wifi" > "$netdev/queues/rx-0/rps_cpus" 2>/dev/null
					printf '2048' > "$netdev/queues/rx-0/rps_flow_cnt" 2>/dev/null ;;
				eth*|wan|lan*|br-lan|pppoe-wan)
					printf '%s' "$rps_mask_wired" > "$netdev/queues/rx-0/rps_cpus" 2>/dev/null
					printf '2048' > "$netdev/queues/rx-0/rps_flow_cnt" 2>/dev/null ;;
			esac
		fi

		if [ -w "$netdev/queues/tx-0/xps_cpus" ]; then
			printf '%s' "$rps_mask_wired" > "$netdev/queues/tx-0/xps_cpus" 2>/dev/null || true
		fi
	done
	log "Threaded NAPI=${threaded_en} and 4-VPE RPS/XPS steering active"
}

# 4. Stock Qorvo QPF4200 (+5V Wi-Fi 6 FEM) High-Gain eLNA/CCA & AQL Tuning
configure_wifi_lowlevel() {
	local aql_limit phy ac
	aql_limit="$(uci -q get nexrouter.core.aql_txq_limit 2>/dev/null || echo 2500)"

	for phy in /sys/kernel/debug/ieee80211/phy*; do
		[ -d "$phy" ] || continue
		if [ -w "$phy/aql_txq_limit" ]; then
			for ac in 0 1 2 3; do
				printf '%s %s %s\n' "$ac" "$aql_limit" "$aql_limit" > "$phy/aql_txq_limit" 2>/dev/null || true
			done
		fi
		[ -w "$phy/aql_enable" ] && printf '1' > "$phy/aql_enable" 2>/dev/null || true

		# Program MT7603EN AGC/CCA register (0x10f18) to unlock Qorvo QPF4200 15.5 dB LNA sensitivity
		if [ -w "$phy/mt76/regidx" ] && [ -w "$phy/mt76/regval" ] && [ ! -d "$phy/mt76/dbdc" ]; then
			printf '0x10f18\n' > "$phy/mt76/regidx" 2>/dev/null || true
			printf '0x00000012\n' > "$phy/mt76/regval" 2>/dev/null || true
		fi
	done

	# Disable PCIe ASPM power saving between MT7621AT and MT7615N/MT7603EN
	if [ -w /sys/module/pcie_aspm/parameters/policy ]; then
		printf 'performance' > /sys/module/pcie_aspm/parameters/policy 2>/dev/null || true
	fi
}

# 5. Verify Hardware Flow Offload (Mainline nftables PPE or MediaTek mtkhnat)
verify_offload() {
	local hwo swo hw_flows
	hwo="$(uci -q get firewall.@defaults[0].flow_offloading_hw 2>/dev/null)"
	swo="$(uci -q get firewall.@defaults[0].flow_offloading 2>/dev/null)"

	if [ -d /sys/kernel/debug/hnat ] || lsmod 2>/dev/null | grep -q 'mtkhnat'; then
		log "MediaTek proprietary WHNAT/HNAT (mtkhnat.ko) engine active"
		return 0
	fi

	if [ "$hwo" = "1" ] && [ "$swo" != "1" ]; then
		uci -q set firewall.@defaults[0].flow_offloading='1'
		uci -q commit firewall
	fi

	if [ -r /proc/net/stat/nf_flowtable ]; then
		hw_flows="$(awk 'NR==2 {print $1+0}' /proc/net/stat/nf_flowtable 2>/dev/null)"
		log "Mainline nftables PPE flowtable active (current hw_flows=${hw_flows:-0})"
	fi
}

start() {
	log "Applying NexRouter v3.3 Stock Silicon Inter-Chip Optimizations (VPEs=$VPE_COUNT)"
	configure_zram_virtual_ram
	configure_irqs
	configure_napi_and_rps
	configure_wifi_lowlevel
	verify_offload
}

stop() {
	:
}

restart() {
	start
}