#!/bin/sh /etc/rc.common
# ===========================================================================
# nexrouter-core (v9.2) — Zero-Freeze 4-VPE SMP, No-Qdisc WAN & Rock-Solid LAN/Wi-Fi
# ===========================================================================
# Fixes the delayed LAN & Wireless disconnection / no-handshake bug:
#   1. Restores standard 300s (`30000` USER_HZ) `br-lan` MAC ageing time and
#      stops `bridger` eBPF so MT7621AT PPE L2/L3 tables never blackhole ARP,
#      DHCP, or WPA 4-way EAPOL handshakes after 30-120 seconds.
#   2. Never toggles `/sys/class/net/*/threaded` at runtime on live interfaces
#      (prevents Linux `NAPI_STATE_SCHED` race that freezes NAPI RX/TX queues).
#   3. Never writes `0x00000012` to `MT7603EN` register `0x10f18` (which zeroed
#      bits [31:8] of the 2.4 GHz PHY AGC register and deafened 2.4 GHz RX!).
#   4. Keeps 802.3x flow control intact on `eth0` (`gmac0 <-> MT7530 Port 6`)
#      so the internal switch buffer pool never deadlocks `lan1..lan3`.
# ===========================================================================

START=98
STOP=10

VPE_COUNT="$(grep -c '^processor' /proc/cpuinfo 2>/dev/null)"
[ "${VPE_COUNT:-0}" -ge 2 ] 2>/dev/null || VPE_COUNT=4

log() { logger -t nexrouter-core -- "$*"; }

# 1. ZRAM Virtual Memory Multiplier for Stock 128 MiB DDR3 (ESMT M15T1G1664A)
configure_zram_virtual_ram() {
	local zram_en
	zram_en="$(uci -q get nexrouter.core.zram_boost 2>/dev/null || echo 1)"
	[ "$zram_en" = "1" ] || return 0

	[ -w /proc/sys/vm/page-cluster ] && printf '0' > /proc/sys/vm/page-cluster 2>/dev/null || true
	[ -w /proc/sys/vm/swappiness ] && printf '100' > /proc/sys/vm/swappiness 2>/dev/null || true

	if [ -b /dev/zram0 ] && ! grep -q '/dev/zram0' /proc/swaps 2>/dev/null; then
		[ -w /sys/block/zram0/max_comp_streams ] && printf '%s' "$VPE_COUNT" > /sys/block/zram0/max_comp_streams 2>/dev/null || true
		if [ -w /sys/block/zram0/comp_algorithm ]; then
			for alg in lz4 lzo-rle lzo zstd; do
				if grep -q "$alg" /sys/block/zram0/comp_algorithm 2>/dev/null; then
					printf '%s' "$alg" > /sys/block/zram0/comp_algorithm 2>/dev/null && break
				fi
			done
		fi
		printf '%s' "$((64 * 1024 * 1024))" > /sys/block/zram0/disksize 2>/dev/null || true
		mkswap /dev/zram0 >/dev/null 2>&1 && swapon -p 100 /dev/zram0 2>/dev/null || true
		log "ZRAM virtual RAM multiplier active (64 MiB compressed pool on stock 128 MiB DDR3)"
	fi
}

set_irq_mask() {
	local mask="$1"; shift
	local irq
	for irq in "$@"; do
		[ -w "/proc/irq/$irq/smp_affinity" ] || continue
		printf '%s' "$mask" > "/proc/irq/$irq/smp_affinity" 2>/dev/null || true
	done
}

# 2. Proven 4-VPE Single-Bit GIC IRQ Partitioning (Eth->2[VPE1], 5G->4[VPE2], 2.4G->8[VPE3])
configure_irqs() {
	local irq_eth="" irq_2g="" irq_5g="" irq_pcie=""
	local line num name

	while read -r line; do
		num="${line%%:*}"
		num="$(printf '%s' "$num" | tr -d ' ')"
		case "$num" in ''|*[!0-9]*) continue ;; esac
		name="$(printf '%s' "$line" | awk '{print $NF}')"
		case "$name" in
			*1e100000.ethernet*|*mtk_soc_eth*|*fe100000*|eth0*|gsw*|*1e004000.crypto*|*eip93*)
				irq_eth="$irq_eth $num" ;;
			*mt7603*|*0000:02:00.0*|*ra0*)
				irq_2g="$irq_2g $num" ;;
			*mt7615*|*0000:01:00.0*|*rai0*)
				irq_5g="$irq_5g $num" ;;
			*mt76*|*1e140000.pcie*|*pcie*)
				irq_pcie="$irq_pcie $num" ;;
		esac
	done < /proc/interrupts

	if [ "$VPE_COUNT" -ge 4 ]; then
		[ -n "$irq_eth" ]  && set_irq_mask 2 $irq_eth
		[ -n "$irq_5g" ]   && set_irq_mask 4 $irq_5g
		[ -z "$irq_5g" ] && [ -n "$irq_pcie" ] && set_irq_mask 4 $irq_pcie
		[ -n "$irq_2g" ]   && set_irq_mask 8 $irq_2g
		log "IRQ affinity (MT7621 GIC Single-VPE): Eth($irq_eth)->VPE1(2), 5G($irq_5g $irq_pcie)->VPE2(4), 2.4G($irq_2g)->VPE3(8)"
	else
		[ -n "$irq_eth" ]  && set_irq_mask 1 $irq_eth
		[ -n "$irq_2g" ]   && set_irq_mask 2 $irq_2g
		[ -n "$irq_5g" ]   && set_irq_mask 2 $irq_5g
		[ -n "$irq_pcie" ] && set_irq_mask 2 $irq_pcie
	fi
}

# 3. 4-VPE RPS/XPS + GRO/GSO Restore + Zero-Drop MT7530 LAN Switch Healer
configure_napi_rps_and_lan_switch() {
	local netdev d rps_mask_wired rps_mask_wifi bp sqm_en wan_dev

	if [ "$VPE_COUNT" -ge 4 ]; then
		rps_mask_wired="3"
		rps_mask_wifi="d"
	else
		rps_mask_wired="3"
		rps_mask_wifi="3"
	fi

	[ -w /proc/sys/net/core/rps_sock_flow_entries ] && \
		printf '32768' > /proc/sys/net/core/rps_sock_flow_entries 2>/dev/null
	[ -w /proc/sys/net/core/netdev_max_backlog ] && \
		printf '10000' > /proc/sys/net/core/netdev_max_backlog 2>/dev/null
	[ -w /proc/sys/net/core/netdev_budget ] && \
		printf '600' > /proc/sys/net/core/netdev_budget 2>/dev/null

	for netdev in /sys/class/net/*; do
		d="$(basename "$netdev")"
		case "$d" in lo) continue ;; esac

		# NOTE: Never toggle $netdev/threaded on live UP interfaces — doing so
		# triggers a Linux kernel NAPI_STATE_SCHED race that freezes RX/TX rings!

		if [ -w "$netdev/queues/rx-0/rps_cpus" ]; then
			case "$d" in
				eth0|wan|pppoe-wan)
					printf '%s' "$rps_mask_wired" > "$netdev/queues/rx-0/rps_cpus" 2>/dev/null
					printf '4096' > "$netdev/queues/rx-0/rps_flow_cnt" 2>/dev/null ;;
				phy*-ap*|wlan*|ra*|rai*)
					printf '%s' "$rps_mask_wifi" > "$netdev/queues/rx-0/rps_cpus" 2>/dev/null
					printf '4096' > "$netdev/queues/rx-0/rps_flow_cnt" 2>/dev/null ;;
				lan*|br-lan)
					printf '0' > "$netdev/queues/rx-0/rps_cpus" 2>/dev/null
					printf '0' > "$netdev/queues/rx-0/rps_flow_cnt" 2>/dev/null ;;
			esac
		fi

		if command -v ethtool >/dev/null 2>&1; then
			ethtool -K "$d" gro on gso on sg on 2>/dev/null || true
			case "$d" in
				lan1|lan2|lan3|wan)
					ethtool --set-eee "$d" eee off 2>/dev/null || true ;;
				eth0)
					# Keep 802.3x flow control enabled on internal gmac0 <-> MT7530 Port 6 trunk
					ethtool -A eth0 rx on tx on 2>/dev/null || true ;;
			esac
		fi
		ip link set "$d" txqueuelen 2000 2>/dev/null || true
	done

	# Ensure all active AP interfaces are enslaved to br-lan so wireless handshakes & DHCP always succeed
	if [ -d /sys/class/net/br-lan ]; then
		for ap_if in /sys/class/net/phy*-ap* /sys/class/net/wlan* /sys/class/net/ra0 /sys/class/net/rai0; do
			[ -d "$ap_if" ] || continue
			ap_name="$(basename "$ap_if")"
			if [ ! -e "/sys/class/net/br-lan/brif/$ap_name" ]; then
				ip link set "$ap_name" master br-lan 2>/dev/null || brctl addif br-lan "$ap_name" 2>/dev/null || true
			fi
		done
	fi

	# Remove WAN root fq_codel shaper unless sqm_enabled=1
	sqm_en="$(uci -q get nexrouter.core.sqm_enabled 2>/dev/null || echo 0)"
	if [ "$sqm_en" != "1" ]; then
		for wan_dev in wan pppoe-wan eth0; do
			tc qdisc del dev "$wan_dev" root 2>/dev/null || true
		done
	fi

	# Use standard 300s (30000 USER_HZ) bridge FDB ageing time so PPE flowtable never desynchronizes from br-lan
	if [ -d /sys/class/net/br-lan/bridge ]; then
		printf '0' > /sys/class/net/br-lan/bridge/stp_state 2>/dev/null || true
		printf '0' > /sys/class/net/br-lan/bridge/forward_delay 2>/dev/null || true
		printf '30000' > /sys/class/net/br-lan/bridge/ageing_time 2>/dev/null || true
		printf '0' > /sys/class/net/br-lan/bridge/multicast_snooping 2>/dev/null || true
	fi
	for bp in /sys/class/net/br-lan/brif/*; do
		[ -d "$bp" ] || continue
		[ -w "$bp/neigh_suppress" ] && printf '0' > "$bp/neigh_suppress" 2>/dev/null || true
		[ -w "$bp/hairpin_mode" ] && printf '0' > "$bp/hairpin_mode" 2>/dev/null || true
	done

	log "4-VPE SMP (Eth IRQ=2, 5G IRQ=4, 2.4G IRQ=8, Wired RPS=3, Wi-Fi RPS=d) + Zero-Freeze br-lan active"
}

# 4. Safe AQL Window (5000/10000 us, threshold 24000 us) + RTS=2347 (No destructive raw PHY register overwrites)
configure_wifi_lowlevel() {
	local aql_low aql_high aql_thr phy
	aql_low="$(uci -q get nexrouter.core.aql_txq_limit 2>/dev/null || echo 5000)"
	[ "${aql_low:-0}" -gt 8000 ] 2>/dev/null && aql_low=5000
	[ "${aql_low:-0}" -lt 3000 ] 2>/dev/null && aql_low=5000
	aql_high=$((aql_low * 2))
	aql_thr="$(uci -q get nexrouter.core.aql_threshold 2>/dev/null || echo 24000)"

	for phy in /sys/kernel/debug/ieee80211/phy*; do
		[ -d "$phy" ] || continue
		[ -w "$phy/aql_threshold" ] && printf '%s\n' "$aql_thr" > "$phy/aql_threshold" 2>/dev/null || true
		if [ -w "$phy/aql_txq_limit" ]; then
			printf '0 2500 5000\n' > "$phy/aql_txq_limit" 2>/dev/null || true
			printf '1 4000 8000\n' > "$phy/aql_txq_limit" 2>/dev/null || true
			printf '2 %s %s\n' "$aql_low" "$aql_high" > "$phy/aql_txq_limit" 2>/dev/null || true
			printf '3 %s %s\n' "$aql_low" "$aql_high" > "$phy/aql_txq_limit" 2>/dev/null || true
		fi
		[ -w "$phy/aql_enable" ] && printf '1' > "$phy/aql_enable" 2>/dev/null || true
	done

	if [ -w /sys/module/pcie_aspm/parameters/policy ]; then
		printf 'performance' > /sys/module/pcie_aspm/parameters/policy 2>/dev/null || true
	fi
	log "5 GHz & 2.4 GHz AQL sweet-spot active (${aql_low}/${aql_high} us, threshold=${aql_thr} us)"
}

verify_offload() {
	local hwo swo hw_flows
	# Stop bridger eBPF if installed so it never collides with MT7621AT PPE L2/L3 br-lan forwarding
	if [ -x /etc/init.d/bridger ]; then
		/etc/init.d/bridger stop 2>/dev/null || true
		/etc/init.d/bridger disable 2>/dev/null || true
	fi

	hwo="$(uci -q get firewall.@defaults[0].flow_offloading_hw 2>/dev/null)"
	swo="$(uci -q get firewall.@defaults[0].flow_offloading 2>/dev/null)"

	if [ -d /sys/kernel/debug/hnat ] || lsmod 2>/dev/null | grep -q 'mtkhnat'; then
		log "MediaTek proprietary WHNAT/HNAT (mtkhnat.ko) engine active"
		return 0
	fi

	if [ "$hwo" = "1" ] && [ "$swo" != "1" ]; then
		uci -q set firewall.@defaults[0].flow_offloading='1'
		uci -q commit firewall
	fi

	if [ -r /proc/net/stat/nf_flowtable ]; then
		hw_flows="$(awk 'NR==2 {print $1+0}' /proc/net/stat/nf_flowtable 2>/dev/null)"
		log "Mainline nftables PPE flowtable active (current hw_flows=${hw_flows:-0})"
	fi
}

start() {
	log "Applying NexRouter v9.2 Zero-Freeze 4-VPE SMP & LAN/Wi-Fi Fastpath (VPEs=$VPE_COUNT)"
	configure_zram_virtual_ram
	configure_irqs
	configure_napi_rps_and_lan_switch
	configure_wifi_lowlevel
	verify_offload
	[ -x /usr/sbin/nexrouter-kernel-sync ] && /usr/sbin/nexrouter-kernel-sync all 2>/dev/null || true
	[ -x /usr/sbin/nexrouter-accel ] && /usr/sbin/nexrouter-accel all 2>/dev/null || true
}

stop() {
	:
}

restart() {
	start
}