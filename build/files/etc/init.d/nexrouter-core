#!/bin/sh /etc/rc.common
# ===========================================================================
# nexrouter-core (v3.5) — Gigabit Wireless Download & L1 Cache Fastpath Engine
# ===========================================================================
# Fixes the 294 Mbps Wireless Download bottleneck (while LAN=1Gbps, Upload=460Mbps)
# on Xiaomi Redmi Router AC2100 (MT7621AT + MT7615N + MT7603EN):
#
#   1. Core 1 L1 D-Cache Co-Location for WAN -> 5 GHz Download:
#      On MT7621AT (2 cores / 4 VPEs), VPE0+VPE1 share Core 0's 32 KB L1 cache
#      and VPE2+VPE3 share Core 1's 32 KB L1 cache. Because MT7621AT lacks hardware
#      WED for mainline mt7615e TX, WAN -> 5 GHz Download passes through the CPU.
#      We pin MT7615N PCIe0 IRQ to VPE2 (0x4) and steer eth0/wan RX RPS to
#      VPE2+VPE3 (0xc) so WAN RX -> mac80211 -> MT7615N PCIe TX never bounces
#      across Core 0 and Core 1 L1 caches!
#   2. Zero Double-Scheduling on Wired Ingress + GRO/GSO 64 KB Super-Packets:
#      Keeps eth0/wan in direct softirq NAPI (`threaded=0`) while enabling
#      `threaded=1` on `mt76` Wi-Fi radios, and enables GRO + GSO + SG across
#      all interfaces so incoming TCP Download segments coalesce into 64 KB
#      super-SKBs before hitting mac80211 hardware A-MSDU (`TX_FRAG_LIST`).
#   3. Deep 64-MPDU AQL Window (`16000` us / `32000` us, threshold `48000` us):
#      Eliminates the 2.5 ms AQL starvation that capped Download at ~294 Mbps.
#   4. 64 MiB ZRAM Virtual RAM Multiplier + Qorvo QPF4200 High-Gain LNA Unlock.
# ===========================================================================

START=98
STOP=10

VPE_COUNT="$(grep -c '^processor' /proc/cpuinfo 2>/dev/null)"
[ "${VPE_COUNT:-0}" -ge 2 ] 2>/dev/null || VPE_COUNT=4

log() { logger -t nexrouter-core -- "$*"; }

# 1. ZRAM Virtual Memory Multiplier for Stock 128 MiB DDR3 (ESMT M15T1G1664A)
configure_zram_virtual_ram() {
	local zram_en
	zram_en="$(uci -q get nexrouter.core.zram_boost 2>/dev/null || echo 1)"
	[ "$zram_en" = "1" ] || return 0

	[ -w /proc/sys/vm/page-cluster ] && printf '0' > /proc/sys/vm/page-cluster 2>/dev/null || true
	[ -w /proc/sys/vm/swappiness ] && printf '100' > /proc/sys/vm/swappiness 2>/dev/null || true

	if [ -b /dev/zram0 ] && ! grep -q '/dev/zram0' /proc/swaps 2>/dev/null; then
		[ -w /sys/block/zram0/max_comp_streams ] && printf '%s' "$VPE_COUNT" > /sys/block/zram0/max_comp_streams 2>/dev/null || true
		if [ -w /sys/block/zram0/comp_algorithm ]; then
			for alg in lz4 lzo-rle lzo zstd; do
				if grep -q "$alg" /sys/block/zram0/comp_algorithm 2>/dev/null; then
					printf '%s' "$alg" > /sys/block/zram0/comp_algorithm 2>/dev/null && break
				fi
			done
		fi
		printf '%s' "$((64 * 1024 * 1024))" > /sys/block/zram0/disksize 2>/dev/null || true
		mkswap /dev/zram0 >/dev/null 2>&1 && swapon -p 100 /dev/zram0 2>/dev/null || true
		log "ZRAM virtual RAM multiplier active (64 MiB compressed pool on stock 128 MiB DDR3)"
	fi
}

set_irq_mask() {
	local mask="$1"; shift
	local irq
	for irq in "$@"; do
		[ -w "/proc/irq/$irq/smp_affinity" ] || continue
		printf '%s' "$mask" > "/proc/irq/$irq/smp_affinity" 2>/dev/null || true
	done
}

# 2. L1-Cache-Aware IRQ Partitioning (Core 0 = Eth/2.4G, Core 1 = 5G High-Speed)
configure_irqs() {
	local irq_eth="" irq_2g="" irq_5g="" irq_pcie=""
	local line num name

	while read -r line; do
		num="${line%%:*}"
		num="$(printf '%s' "$num" | tr -d ' ')"
		case "$num" in ''|*[!0-9]*) continue ;; esac
		name="$(printf '%s' "$line" | awk '{print $NF}')"
		case "$name" in
			*1e100000.ethernet*|*mtk_soc_eth*|*fe100000*|eth0*|gsw*)
				irq_eth="$irq_eth $num" ;;
			*mt7603*|*0000:02:00.0*|*ra0*)
				irq_2g="$irq_2g $num" ;;
			*mt7615*|*0000:01:00.0*|*rai0*)
				irq_5g="$irq_5g $num" ;;
			*mt76*|*1e140000.pcie*|*pcie*)
				irq_pcie="$irq_pcie $num" ;;
		esac
	done < /proc/interrupts

	if [ "$VPE_COUNT" -ge 4 ]; then
		# Core 0: VPE0 (0x1) = GMAC Frame Engine, VPE1 (0x2) = MT7603EN 2.4GHz
		# Core 1: VPE2 (0x4) = MT7615N 5GHz PCIe0, VPE3 (0x8) = 5GHz Download RPS/TX
		[ -n "$irq_eth" ]  && set_irq_mask 1 $irq_eth
		[ -n "$irq_2g" ]   && set_irq_mask 2 $irq_2g
		[ -n "$irq_5g" ]   && set_irq_mask 4 $irq_5g
		[ -z "$irq_5g" ] && [ -n "$irq_pcie" ] && set_irq_mask 4 $irq_pcie
		log "IRQ affinity (L1 Cache Co-Located): Eth($irq_eth)->VPE0, 2.4G($irq_2g)->VPE1, 5G($irq_5g $irq_pcie)->VPE2(Core1)"
	else
		[ -n "$irq_eth" ]  && set_irq_mask 1 $irq_eth
		[ -n "$irq_2g" ]   && set_irq_mask 2 $irq_2g
		[ -n "$irq_5g" ]   && set_irq_mask 2 $irq_5g
		[ -n "$irq_pcie" ] && set_irq_mask 2 $irq_pcie
	fi
}

# 3. Core 1 L1-Cache Download Fastpath (RPS=0xc) + GRO/GSO Super-Packet Coalescing
configure_napi_rps_and_gro() {
	local threaded_en netdev d rps_mask_download rps_mask_wifi_rx
	threaded_en="$(uci -q get nexrouter.core.threaded_napi 2>/dev/null || echo 1)"

	if [ "$VPE_COUNT" -ge 4 ]; then
		# Steer WAN/Eth RX softirqs to Core 1 (VPE2+VPE3 = 0xc) so WAN->5G Download
		# shares Core 1's 32KB L1 D-Cache with MT7615N PCIe0 TX!
		rps_mask_download="c"
		# Steer Wi-Fi Upload RX softirqs to VPE1+VPE3 (0xa) to feed GMAC1 WAN TX
		rps_mask_wifi_rx="8"
	else
		rps_mask_download="3"
		rps_mask_wifi_rx="3"
	fi

	[ -w /proc/sys/net/core/rps_sock_flow_entries ] && 		printf '32768' > /proc/sys/net/core/rps_sock_flow_entries 2>/dev/null
	[ -w /proc/sys/net/core/netdev_max_backlog ] && 		printf '8192' > /proc/sys/net/core/netdev_max_backlog 2>/dev/null
	[ -w /proc/sys/net/core/netdev_budget ] && 		printf '600' > /proc/sys/net/core/netdev_budget 2>/dev/null

	for netdev in /sys/class/net/*; do
		d="$(basename "$netdev")"
		case "$d" in lo) continue ;; esac

		# Keep wired eth0/wan/lan in direct softirq NAPI (threaded=0) to avoid
		# double kthread scheduling latency on Download; enable threaded=1 on Wi-Fi
		if [ -w "$netdev/threaded" ]; then
			case "$d" in
				eth*|wan|lan*|br-lan)
					printf '0' > "$netdev/threaded" 2>/dev/null || true ;;
				phy*-ap*|wlan*|ra*|rai*)
					[ "$threaded_en" = "1" ] && printf '1' > "$netdev/threaded" 2>/dev/null || true ;;
			esac
		fi

		if [ -w "$netdev/queues/rx-0/rps_cpus" ]; then
			case "$d" in
				eth*|wan|pppoe-wan)
					printf '%s' "$rps_mask_download" > "$netdev/queues/rx-0/rps_cpus" 2>/dev/null
					printf '4096' > "$netdev/queues/rx-0/rps_flow_cnt" 2>/dev/null ;;
				phy*-ap*|wlan*|ra*|rai*)
					printf '%s' "$rps_mask_wifi_rx" > "$netdev/queues/rx-0/rps_cpus" 2>/dev/null
					printf '4096' > "$netdev/queues/rx-0/rps_flow_cnt" 2>/dev/null ;;
				lan*|br-lan)
					printf '2' > "$netdev/queues/rx-0/rps_cpus" 2>/dev/null
					printf '2048' > "$netdev/queues/rx-0/rps_flow_cnt" 2>/dev/null ;;
			esac
		fi

		if [ -w "$netdev/queues/tx-0/xps_cpus" ]; then
			case "$d" in
				phy*-ap*|wlan*|rai*)
					printf 'c' > "$netdev/queues/tx-0/xps_cpus" 2>/dev/null || true ;;
				*)
					printf '3' > "$netdev/queues/tx-0/xps_cpus" 2>/dev/null || true ;;
			esac
		fi

		# Enable GRO/GSO/SG super-packet coalescing so 1500B WAN TCP Download frames
		# merge into 64KB super-packets before traversing mac80211 -> mt7615e A-MSDU
		if command -v ethtool >/dev/null 2>&1; then
			ethtool -K "$d" gro on gso on tso on sg on 2>/dev/null || true
		fi
		ip link set "$d" txqueuelen 2000 2>/dev/null || true
	done
	log "Core 1 L1-cache WAN->5G Download fastpath (RPS=0xc) + GRO/GSO super-packets active"
}

# 4. Unthrottled 5 GHz Downlink AQL Window (16000/32000 us) + QPF4200 LNA Unlock
configure_wifi_lowlevel() {
	local aql_low aql_high aql_thr phy ac
	aql_low="$(uci -q get nexrouter.core.aql_txq_limit 2>/dev/null || echo 16000)"
	[ "${aql_low:-0}" -lt 8000 ] 2>/dev/null && aql_low=16000
	aql_high=$((aql_low * 2))
	aql_thr="$(uci -q get nexrouter.core.aql_threshold 2>/dev/null || echo 48000)"

	for phy in /sys/kernel/debug/ieee80211/phy*; do
		[ -d "$phy" ] || continue
		[ -w "$phy/aql_threshold" ] && printf '%s
' "$aql_thr" > "$phy/aql_threshold" 2>/dev/null || true
		if [ -w "$phy/aql_txq_limit" ]; then
			# AC_VO (0) & AC_VI (1): low latency; AC_BE (2) & AC_BK (3): deep 64-MPDU aggregation
			printf '0 4000 8000
' > "$phy/aql_txq_limit" 2>/dev/null || true
			printf '1 8000 16000
' > "$phy/aql_txq_limit" 2>/dev/null || true
			printf '2 %s %s
' "$aql_low" "$aql_high" > "$phy/aql_txq_limit" 2>/dev/null || true
			printf '3 %s %s
' "$aql_low" "$aql_high" > "$phy/aql_txq_limit" 2>/dev/null || true
		fi
		[ -w "$phy/aql_enable" ] && printf '1' > "$phy/aql_enable" 2>/dev/null || true

		# Program MT7603EN AGC/CCA register (0x10f18) to unlock Qorvo QPF4200 15.5 dB LNA sensitivity
		if [ -w "$phy/mt76/regidx" ] && [ -w "$phy/mt76/regval" ] && [ ! -d "$phy/mt76/dbdc" ]; then
			printf '0x10f18
' > "$phy/mt76/regidx" 2>/dev/null || true
			printf '0x00000012
' > "$phy/mt76/regval" 2>/dev/null || true
		fi
	done

	for phy_name in phy0 phy1; do
		iw phy "$phy_name" set rts 2347 2>/dev/null || true
	done

	if [ -w /sys/module/pcie_aspm/parameters/policy ]; then
		printf 'performance' > /sys/module/pcie_aspm/parameters/policy 2>/dev/null || true
	fi
	log "5 GHz Downlink AQL window unlocked (${aql_low}/${aql_high} us, threshold=${aql_thr} us, RTS=2347)"
}

# 5. Verify Hardware Flow Offload (Mainline nftables PPE or MediaTek mtkhnat)
verify_offload() {
	local hwo swo hw_flows
	hwo="$(uci -q get firewall.@defaults[0].flow_offloading_hw 2>/dev/null)"
	swo="$(uci -q get firewall.@defaults[0].flow_offloading 2>/dev/null)"

	if [ -d /sys/kernel/debug/hnat ] || lsmod 2>/dev/null | grep -q 'mtkhnat'; then
		log "MediaTek proprietary WHNAT/HNAT (mtkhnat.ko) engine active"
		return 0
	fi

	if [ "$hwo" = "1" ] && [ "$swo" != "1" ]; then
		uci -q set firewall.@defaults[0].flow_offloading='1'
		uci -q commit firewall
	fi

	if [ -r /proc/net/stat/nf_flowtable ]; then
		hw_flows="$(awk 'NR==2 {print $1+0}' /proc/net/stat/nf_flowtable 2>/dev/null)"
		log "Mainline nftables PPE flowtable active (current hw_flows=${hw_flows:-0})"
	fi
}

start() {
	log "Applying NexRouter v3.5 Gigabit Wireless Download & L1 Cache Fastpath (VPEs=$VPE_COUNT)"
	configure_zram_virtual_ram
	configure_irqs
	configure_napi_rps_and_gro
	configure_wifi_lowlevel
	verify_offload
}

stop() {
	:
}

restart() {
	start
}
