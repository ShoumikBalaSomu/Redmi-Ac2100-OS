#!/bin/sh /etc/rc.common
# ===========================================================================
# nexrouter-farlink — Autonomous Far-Device Range Acceleration & Roaming Daemon
# ===========================================================================

START=96
STOP=10
USE_PROCD=1

PROG="/usr/libexec/nexrouter/farlink-daemon"

start_service() {
	[ -x "$PROG" ] || return 0

	procd_open_instance farlink
	procd_set_param command /bin/sh "$PROG"
	procd_set_param respawn 3600 5 0
	procd_set_param limits core="unlimited"
	procd_set_param stdout 0
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	killall -9 farlink-daemon 2>/dev/null || true
}
