#!/bin/sh /etc/rc.common
# ===========================================================================
# nexrouter-farlink (v2.0) — Dynamic 802.11k/v Band Steering & Airtime Daemon
# ===========================================================================

START=99
STOP=10
USE_PROCD=1

PROG="/usr/libexec/nexrouter/farlink-daemon"

start_service() {
	[ -x "$PROG" ] || return 0
	[ "$(uci -q get nexrouter.roaming.enabled 2>/dev/null || echo 1)" = "1" ] || return 0

	procd_open_instance farlink
	procd_set_param command /bin/sh "$PROG"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 0
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	killall farlink-daemon 2>/dev/null || true
}
