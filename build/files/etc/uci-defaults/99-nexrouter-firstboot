#!/bin/sh
# ---------------------------------------------------------------------------
# NexRouter first-boot provisioning (UCI defaults hook)
# ---------------------------------------------------------------------------
# OpenWrt runs every executable script in /etc/uci-defaults once on first boot,
# then deletes it. This is where NexRouter applies its baseline: performance
# offloads, qdisc defaults, the web UI, DNS hardening and the telemetry
# exporter.
#
# DESIGN RULES enforced here (see docs/03-performance-reality.md):
#   1. Hardware flow offload ON by default. This is the single change that
#      closes the gap with the vendor's proprietary HNAT driver.
#   2. SQM/CAKE OFF by default. CAKE is single-threaded and tops out near
#      ~150 Mbps on this 880 MHz core. Enabling it would silently cut a
#      500 Mbps link to a third of its speed. fq_codel is used instead: it
#      gives most of the bufferbloat benefit at a fraction of the CPU cost.
#      A "bufferbloat mode" toggle in the UI switches to CAKE knowingly.
#   3. No on-device neural inference. Ever. See docs/05-intelligence-layer.md
#      for what the intelligence layer actually does and why.
#   4. Nothing is sent off the device unless the user enables it.
# ---------------------------------------------------------------------------

[ -e /etc/nexrouter-release ] && . /etc/nexrouter-release

echo "nexrouter: first-boot provisioning (${NEXROUTER_VERSION:-dev})"

# ===========================================================================
# 1. Firewall: nftables flow offloading & hardware PPE offload
# ===========================================================================
uci -q batch <<-EOF
	set firewall.@defaults[0].flow_offloading='1'
	set firewall.@defaults[0].flow_offloading_hw='1'
	set firewall.@defaults[0].syn_flood='1'
	set firewall.@defaults[0].synflood_rate='100'
	set firewall.@defaults[0].input='REJECT'
	set firewall.@defaults[0].output='ACCEPT'
	set firewall.@defaults[0].forward='REJECT'
	commit firewall
EOF

# ===========================================================================
# 2. Network: offload-friendly defaults, no SQM
# ===========================================================================
uci -q batch <<-EOF
	set network.globals.packet_steering='1'
	set network.wan.proto='pppoe'
	set network.wan.username='your_pppoe_username'
	set network.wan.password='your_pppoe_password'
	set network.wan.ipv6='auto'
	commit network
EOF

# fq_codel on the WAN egress qdisc: fair queuing plus CoDel AQM.
mkdir -p /etc/hotplug.d/iface
cat > /etc/hotplug.d/iface/20-nexrouter-qdisc <<'QEOF'
[ "$ACTION" = "ifup" ] || exit 0
[ "$INTERFACE" = "wan" ] || [ "$INTERFACE" = "wan6" ] || exit 0
dev="$(uci -q get network.wan.device)"
[ -n "$dev" ] || exit 0
tc qdisc replace dev "$dev" root fq_codel \
   limit 10240 flows 1024 quantum 3028b target 5ms interval 100ms \
   memory_limit 32Mb ecn 2>/dev/null
QEOF
chmod 0755 /etc/hotplug.d/iface/20-nexrouter-qdisc

# ===========================================================================
# 3. Kernel / sysctl tuning
# ===========================================================================
mkdir -p /etc/sysctl.d
cat > /etc/sysctl.d/99-nexrouter.conf <<'SEOF'
# --- conntrack -------------------------------------------------------------
net.netfilter.nf_conntrack_max=65536
net.netfilter.nf_conntrack_buckets=16384
net.netfilter.nf_conntrack_tcp_timeout_established=43200
net.netfilter.nf_conntrack_udp_timeout=30
net.netfilter.nf_conntrack_udp_timeout_stream=120

# --- TCP -------------------------------------------------------------------
net.core.rmem_max=8388608
net.core.wmem_max=8388608
net.ipv4.tcp_rmem=4096 131072 8388608
net.ipv4.tcp_wmem=4096 131072 8388608
net.core.netdev_max_backlog=10000
net.core.netdev_budget=600
net.core.somaxconn=4096
net.ipv4.tcp_congestion_control=bbr
net.ipv4.tcp_fastopen=3
net.ipv4.tcp_mtu_probing=1
net.ipv4.tcp_slow_start_after_idle=0
net.ipv4.tcp_fin_timeout=15

# --- filtering -------------------------------------------------------------
net.ipv4.conf.all.rp_filter=1
net.ipv4.conf.default.rp_filter=1
net.ipv4.conf.all.log_martians=0
net.ipv4.conf.default.log_martians=0
net.ipv4.conf.all.accept_redirects=0
net.ipv4.conf.all.send_redirects=0
net.ipv4.conf.all.accept_source_route=0
net.ipv4.icmp_echo_ignore_broadcasts=1
net.ipv4.icmp_ignore_bogus_error_responses=1
net.ipv6.conf.all.accept_redirects=0
net.ipv6.conf.all.accept_source_route=0

# --- VM --------------------------------------------------------------------
vm.swappiness=10
vm.dirty_ratio=10
vm.dirty_background_ratio=5
vm.min_free_kbytes=8192
SEOF

sysctl --system >/dev/null 2>&1

# ===========================================================================
# 4. Web UI: LuCI with Argon Theme & NexRouter SPA
# ===========================================================================
uci -q batch <<-EOF
	set uhttpd.main.index_page='index.html'
	set uhttpd.main.rfc1918_filter='0'
	set uhttpd.main.max_requests='8'
	set uhttpd.main.script_timeout='60'
	set luci.main.mediaurlbase='/luci-static/argon'
	commit uhttpd
	commit luci
EOF

if [ -d /www/nex ]; then
	uci -q batch <<-EOF
		add_list uhttpd.main.alias '/nex=/www/nex'
		commit uhttpd
	EOF
fi

# ===========================================================================
# 5. DNS Hardening & DNS-over-HTTPS (DoH Proxy)
# ===========================================================================
uci -q batch <<-EOF
	set dhcp.@dnsmasq[0].rebind_protection='1'
	set dhcp.@dnsmasq[0].rebind_localhost='1'
	set dhcp.@dnsmasq[0].localservice='1'
	set dhcp.@dnsmasq[0].nonwildcard='1'
	set dhcp.@dnsmasq[0].cachesize='4096'
	set dhcp.@dnsmasq[0].min_cache_ttl='300'
	set dhcp.@dnsmasq[0].negcache='1'
	commit dhcp
EOF

if [ -x /etc/init.d/https-dns-proxy ]; then
	/etc/init.d/https-dns-proxy enable 2>/dev/null
fi

# ===========================================================================
# 6. UPnP & Port Forwarding Defaults
# ===========================================================================
uci -q batch <<-EOF
	set upnpd.config.enabled='1'
	set upnpd.config.enable_natpmp='1'
	set upnpd.config.enable_upnp='1'
	set upnpd.config.secure_mode='1'
	commit upnpd
EOF

# ===========================================================================
# 7. Telemetry & Intelligence Layer
# ===========================================================================
uci -q batch <<-EOF
	set softflowd.@softflowd[0].enabled='0'
	commit softflowd
	set nexrouter.core.enabled='1'
	set nexrouter.insight.enabled='1'
	set nexrouter.insight.mode='heuristic'
	set nexrouter.insight.export='0'
	set nexrouter.telemetry.phone_home='0'
	set nexrouter.telemetry.crash_reporting='0'
	commit nexrouter
EOF

# ===========================================================================
# 8. WiFi: Maximum Throughput & MU-MIMO Beamforming (MT7603 + MT7615)
# ===========================================================================
[ -s /etc/config/wireless ] || wifi config
for dev in $(uci -q show wireless | grep -o 'wireless\.radio[0-9]' | sort -u | cut -d. -f2); do
	band="$(uci -q get wireless.$dev.band 2>/dev/null || echo '')"
	if [ "$band" = "5g" ]; then
		uci -q batch <<-EOF
			set wireless.$dev.channel='149'
			set wireless.$dev.htmode='VHT80'
			set wireless.$dev.country='BD'
			set wireless.$dev.ldpc='1'
			set wireless.$dev.short_gi='1'
			set wireless.$dev.amsdu='0'
			set wireless.$dev.beamformer='1'
			set wireless.$dev.mu_beamformer='1'
			set wireless.$dev.cell_density='0'
			set wireless.$dev.disabled='0'
			set wireless.$dev.txpower='24'
			set wireless.$dev.rts_threshold='2346'
		EOF
	elif [ "$band" = "2g" ]; then
		uci -q batch <<-EOF
			set wireless.$dev.channel='6'
			set wireless.$dev.htmode='HT40'
			set wireless.$dev.noscan='1'
			set wireless.$dev.country='BD'
			set wireless.$dev.ldpc='1'
			set wireless.$dev.short_gi='1'
			set wireless.$dev.cell_density='0'
			set wireless.$dev.disabled='0'
			set wireless.$dev.txpower='20'
			set wireless.$dev.rts_threshold='2346'
		EOF
	fi
done

for iface in $(uci -q show wireless | grep -o 'wireless\.[a-zA-Z0-9_]*\.device' | cut -d. -f2); do
	dev="$(uci -q get wireless.$iface.device 2>/dev/null || echo '')"
	band="$(uci -q get wireless.$dev.band 2>/dev/null || echo '')"
	if [ "$band" = "5g" ]; then
		uci -q batch <<-EOF
			set wireless.$iface.ssid='NexRouter_5G'
			set wireless.$iface.encryption='sae-mixed'
			set wireless.$iface.key='12345678'
			set wireless.$iface.ieee80211w='1'
			set wireless.$iface.wmm='1'
			set wireless.$iface.ieee80211k='1'
			set wireless.$iface.ieee80211v='1'
			set wireless.$iface.disassoc_low_ack='0'
		EOF
	elif [ "$band" = "2g" ]; then
		uci -q batch <<-EOF
			set wireless.$iface.ssid='NexRouter_2.4G'
			set wireless.$iface.encryption='sae-mixed'
			set wireless.$iface.key='12345678'
			set wireless.$iface.ieee80211w='1'
			set wireless.$iface.wmm='1'
			set wireless.$iface.ieee80211k='1'
			set wireless.$iface.ieee80211v='1'
			set wireless.$iface.disassoc_low_ack='0'
		EOF
	fi
done
uci -q commit wireless

# ===========================================================================
# 9. Timezone & Password Defaults
# ===========================================================================
uci -q batch <<-EOF
	set system.@system[0].zonename='Asia/Dhaka'
	set system.@system[0].timezone='<+06>-6'
	commit system
EOF

passwd -d root 2>/dev/null || true

# ===========================================================================
# 10. Enable All NexRouter Services
# ===========================================================================
for svc in miniupnpd nlbwmon ttyd https-dns-proxy nexrouter-smp nexrouter-core nexrouter-insight nexrouter-farlink; do
	[ -x "/etc/init.d/$svc" ] && "/etc/init.d/$svc" enable 2>/dev/null
done

echo "nexrouter: provisioning complete — open http://<router>/nex/"
exit 0
