#!/bin/sh
# Automatically synchronize 802.11k RRM neighbor reports across dual-band APs
[ "$ACTION" = "add" ] || [ "$ACTION" = "ifup" ] || [ -z "$ACTION" ] || exit 0

sleep 1
nr_2g=$(ubus call hostapd.phy0-ap0 rrm_nr_get_own 2>/dev/null | grep -o '"[0-9a-fA-F]\{30,\}"' | tr -d '"')
nr_5g=$(ubus call hostapd.phy1-ap0 rrm_nr_get_own 2>/dev/null | grep -o '"[0-9a-fA-F]\{30,\}"' | tr -d '"')

if [ -n "$nr_2g" ]; then
	ubus call hostapd.phy1-ap0 rrm_nr_set "{\"list\":[[\"9c:9d:7e:18:c4:56\",\"*\",\"$nr_2g\"]]}" 2>/dev/null
fi
if [ -n "$nr_5g" ]; then
	ubus call hostapd.phy0-ap0 rrm_nr_set "{\"list\":[[\"9c:9d:7e:18:c4:57\",\"*\",\"$nr_5g\"]]}" 2>/dev/null
fi
