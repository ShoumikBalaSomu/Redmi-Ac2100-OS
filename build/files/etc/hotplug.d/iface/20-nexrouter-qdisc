#!/bin/sh
# ===========================================================================
# 20-nexrouter-qdisc (v3.5) — High-Throughput Gigabit fq_codel on WAN Egress
# ===========================================================================
# Uses quantum 3028 (2x MTU super-quantum) and 8 MiB buffer ceiling on WAN
# egress ONLY so Wireless Download (WAN -> WLAN) is never throttled.
# ===========================================================================
[ "$ACTION" = "ifup" ] || exit 0
[ "$INTERFACE" = "wan" ] || [ "$INTERFACE" = "wan6" ] || exit 0

dev="$(uci -q get network.wan.device 2>/dev/null)"
[ -n "$dev" ] || dev="$(uci -q get network.wan.ifname 2>/dev/null)"
[ -n "$dev" ] || exit 0

current_qdisc="$(tc qdisc show dev "$dev" 2>/dev/null | head -n1)"
case "$current_qdisc" in
	*cake*) exit 0 ;;
esac

tc qdisc replace dev "$dev" root fq_codel 	limit 8192 flows 1024 quantum 3028 target 5ms interval 100ms 	memory_limit 8Mb ecn 2>/dev/null

ip link set "$dev" txqueuelen 2000 2>/dev/null || true
