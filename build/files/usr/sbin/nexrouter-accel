#!/bin/sh
# ===========================================================================
# /usr/sbin/nexrouter-accel (v5.0.0 — Apex Silicon & Register Engine)
# ===========================================================================
# Directly programs and verifies hardware registers across:
#   - MT7615N (5 GHz 4x4, PCIe0):
#       * 0x4208 (MT_WPDMA_GLO_CFG): TX_WB_DDONE (BIT 6) + 256B PCIe Burst
#       * 0x4210 (MT_DELAY_INT_CFG): 0x80108010 (16-pkt / 20us HW IRQ Coalescing)
#       * 0x21210 (MT_AGG_ACR): Clear PKT_TIME_EN (prevent 24Mbps RTS on retry)
#       * MU-MIMO / STA_REC_BF Guard: Auto-cleans phantom [MU-BEAMFORMER] flags
#         on unpatched ImageBuilder kernels while enabling full PFMU on patched builds
#   - MT7603EN (2.4 GHz 2x2, PCIe1) + 2x Qorvo QPF4200 (+5V Wi-Fi 6 FEMs):
#       * 0x10f18 = 0x00000012 (Unlock 15.5 dB LNA gain / 2.1 dB NF)
#   - MT7621AT SoC:
#       * EIP-93 Hardware Crypto Engine (0x1e004000, IRQ -> VPE1 mask 2)
#       * Bridger eBPF + 16,384-entry PPE Flowtable + Conntrack Liberal TCP
# ===========================================================================

log() { logger -t nexrouter-accel -- "$*"; }

apply_mt7603_and_mt7615_registers() {
	local phy cur_acr new_acr cur_glo new_glo
	for phy in /sys/kernel/debug/ieee80211/phy*; do
		[ -d "$phy/mt76" ] || continue
		[ -w "$phy/mt76/regidx" ] && [ -w "$phy/mt76/regval" ] || continue

		if [ ! -d "$phy/mt76/dbdc" ]; then
			# MT7603EN (2.4 GHz, PCIe1):
			# Unlock Qorvo QPF4200 +5V external Wi-Fi 6 LNA gain (15.5 dB, 2.1 dB NF)
			printf '0x10f18\n' > "$phy/mt76/regidx" 2>/dev/null || true
			printf '0x00000012\n' > "$phy/mt76/regval" 2>/dev/null || true
		else
			# MT7615N (5 GHz 4x4, PCIe0):
			# 1. Program MT_AGG_ACR (0x21210) per mt_wifi v5.0.5.0 to prevent false RTS on A-MPDU retries
			printf '0x21210\n' > "$phy/mt76/regidx" 2>/dev/null || true
			cur_acr="$(cat "$phy/mt76/regval" 2>/dev/null | head -n1)"
			case "$cur_acr" in
				0x*)
					new_acr="$(printf '0x%08x' $(( cur_acr & ~0x4 )) 2>/dev/null)"
					[ -n "$new_acr" ] && printf '%s\n' "$new_acr" > "$phy/mt76/regval" 2>/dev/null || true
					;;
			esac
			# 2. Program MT_DELAY_INT_CFG (0x4210 = 0x80108010) for 16-pkt / 20us HW IRQ coalescing (#402)
			printf '0x4210\n' > "$phy/mt76/regidx" 2>/dev/null || true
			printf '0x80108010\n' > "$phy/mt76/regval" 2>/dev/null || true
			# 3. Program MT_WPDMA_GLO_CFG (0x4208): enable TX_WB_DDONE (BIT 6) & 128B/256B PCIe DMA burst
			printf '0x4208\n' > "$phy/mt76/regidx" 2>/dev/null || true
			cur_glo="$(cat "$phy/mt76/regval" 2>/dev/null | head -n1)"
			case "$cur_glo" in
				0x*)
					new_glo="$(printf '0x%08x' $(( cur_glo | 0x40 )) 2>/dev/null)"
					[ -n "$new_glo" ] && printf '%s\n' "$new_glo" > "$phy/mt76/regval" 2>/dev/null || true
					;;
			esac
		fi
	done
}

verify_and_fix_mumimo_state() {
	if lsmod 2>/dev/null | grep -q 'mt_wifi'; then
		log "MU-MIMO Status: Hardware 4x4 eBF/iBF + MU-MIMO active via MediaTek mt_wifi.ko PFMU"
		return 0
	fi

	local vht_cap_hex has_bf_cap=0
	vht_cap_hex="$(iw phy phy1 info 2>/dev/null | awk '/VHT Capabilities/ {print $3}' | tr -d '():')"
	case "$vht_cap_hex" in
		0x*)
			if [ $(( vht_cap_hex & 0x80800 )) -ne 0 ] 2>/dev/null; then
				has_bf_cap=1
			fi
			;;
	esac

	if [ "$has_bf_cap" = "1" ]; then
		log "MU-MIMO Status: Patched mt7615e detected (VHT cap $vht_cap_hex with STA_REC_BF PFMU MCU TLV active)"
	else
		local mu_uci su_uci changed=0 radio
		for radio in radio0 radio1; do
			mu_uci="$(uci -q get wireless.$radio.mu_beamformer 2>/dev/null)"
			su_uci="$(uci -q get wireless.$radio.su_beamformer 2>/dev/null)"
			if [ "$mu_uci" = "1" ] || [ "$su_uci" = "1" ]; then
				uci -q set "wireless.$radio.mu_beamformer=0"
				uci -q set "wireless.$radio.su_beamformer=0"
				uci -q delete "wireless.$radio.beamformer" 2>/dev/null || true
				changed=1
			fi
		done
		if [ "$changed" = "1" ]; then
			uci -q commit wireless
			wifi reload >/dev/null 2>&1 &
			log "MU-MIMO Guard: Cleared unbacked mu_beamformer=1 on stock mt7615e (prevents NDPA sounding stalls)"
		else
			log "MU-MIMO Guard: Verified clean 4x4 VHT80 state on stock mt7615e (no phantom NDPA sounding stalls)"
		fi
	fi
}

enable_hw_wpa3_and_eip93_crypto() {
	modprobe crypto-hw-eip93 2>/dev/null || insmod /lib/modules/$(uname -r)/crypto-hw-eip93.ko 2>/dev/null || true
	local crypto_irq
	crypto_irq="$(awk '/1e004000.crypto|eip93/ {gsub(/:/,"",$1); print $1}' /proc/interrupts 2>/dev/null)"
	[ -n "$crypto_irq" ] && [ -w "/proc/irq/$crypto_irq/smp_affinity" ] && printf '2' > "/proc/irq/$crypto_irq/smp_affinity" 2>/dev/null || true

	local iface dev band changed=0
	for iface in $(uci -q show wireless 2>/dev/null | grep -o 'wireless\.[a-zA-Z0-9_]*\.device' | cut -d. -f2); do
		dev="$(uci -q get wireless.$iface.device 2>/dev/null)"
		band="$(uci -q get wireless.$dev.band 2>/dev/null)"
		if [ "$band" = "5g" ]; then
			if [ "$(uci -q get wireless.$iface.mbo 2>/dev/null)" != "1" ]; then
				uci -q set "wireless.$iface.encryption=sae"
				uci -q set "wireless.$iface.ieee80211w=2"
				uci -q set "wireless.$iface.sae_pwe=2"
				uci -q set "wireless.$iface.ocv=0"
				uci -q set "wireless.$iface.wpa_group_rekey=86400"
				uci -q set "wireless.$iface.eapol_key_retries=1"
				uci -q set "wireless.$iface.mbo=1"
				uci -q set "wireless.$iface.rnr=1"
				uci -q set "wireless.$iface.okc=1"
				uci -q set "wireless.$iface.sae_require_mfp=1"
				uci -q set "wireless.$iface.qos_map_set=0,0,2,16,1,1,255,255,18,22,24,38,40,40,44,46,48,56"
				changed=1
			fi
		fi
	done
	[ "$changed" = "1" ] && uci -q commit wireless
	log "Hardware WPA3-SAE + AX1800 Wi-Fi 6 MBO/RNR/OKC/QoS-Map active"
}

enable_bridger_and_ppe_fastpath() {
	if [ -x /etc/init.d/bridger ]; then
		/etc/init.d/bridger enable 2>/dev/null || true
		/etc/init.d/bridger restart 2>/dev/null || true
		log "bridger eBPF L2 bridge offload active on eth0 -> phy1-ap0"
	fi
	sysctl -w net.netfilter.nf_conntrack_tcp_be_liberal=1 >/dev/null 2>&1 || true
	sysctl -w net.netfilter.nf_conntrack_tcp_no_window_check=1 >/dev/null 2>&1 || true
}

dump_silicon_status() {
	echo "=== NexRouter v5.0.0 Apex Silicon Register & Offload Audit ==="
	for phy in /sys/kernel/debug/ieee80211/phy*; do
		[ -d "$phy/mt76" ] || continue
		if [ -d "$phy/mt76/dbdc" ]; then
			printf '0x4208\n' > "$phy/mt76/regidx" 2>/dev/null; glo="$(cat "$phy/mt76/regval" 2>/dev/null)"
			printf '0x4210\n' > "$phy/mt76/regidx" 2>/dev/null; dint="$(cat "$phy/mt76/regval" 2>/dev/null)"
			printf '0x21210\n' > "$phy/mt76/regidx" 2>/dev/null; acr="$(cat "$phy/mt76/regval" 2>/dev/null)"
			echo "MT7615N (5G 4x4)   : WPDMA_GLO_CFG(0x4208)=$glo | DELAY_INT(0x4210)=$dint | AGG_ACR(0x21210)=$acr"
		else
			printf '0x10f18\n' > "$phy/mt76/regidx" 2>/dev/null; lna="$(cat "$phy/mt76/regval" 2>/dev/null)"
			echo "MT7603EN (2.4G 2x2): QPF4200_LNA_AGC(0x10f18)=$lna"
		fi
	done
	echo "EIP-93 HW Crypto   : $(grep -c 'eip93' /proc/crypto 2>/dev/null || echo 0) hardware cipher algorithms registered"
	echo "ZRAM Virtual Swap  : $(grep '/dev/zram0' /proc/swaps 2>/dev/null || echo 'inactive')"
	echo "GIC VPE Interrupts :"
	grep -E '1e100000.ethernet|mt76|eip93|crypto' /proc/interrupts 2>/dev/null || true
}

case "${1:-all}" in
	status)
		dump_silicon_status
		;;
	mumimo-check)
		verify_and_fix_mumimo_state
		;;
	registers)
		apply_mt7603_and_mt7615_registers
		;;
	*)
		apply_mt7603_and_mt7615_registers
		verify_and_fix_mumimo_state
		enable_hw_wpa3_and_eip93_crypto
		enable_bridger_and_ppe_fastpath
		;;
esac
