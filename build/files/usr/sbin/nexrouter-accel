#!/bin/sh
# ===========================================================================
# nexrouter-accel (v4.0) — Reverse-Engineered MediaTek Silicon & Offload Tool
# ===========================================================================
# Applies hardware register tuning reverse-engineered from MediaTek's closed-
# source `mt_wifi` v5.0.5.0 SDK (CatWrt, Xiaomi Stock, D-Link DIR-882, ASUS
# RT-AC85P, Keenetic KN-3010) and manages the MT7621AT PPE / eBPF datapath:
#
#   1. Single-Bit Power-of-2 MIPS GIC Interrupt Pinning (MT7621 Programming Guide):
#      - VPE0 (`1`): System Timer + RPS SoftIRQ consumer
#      - VPE1 (`2`): `eth0` GMAC Hardware IRQ (`1e100000.ethernet`)
#      - VPE2 (`4`): `MT7615N` 5 GHz PCIe0 Hardware IRQ (`0000:01:00.0`)
#      - VPE3 (`8`): `MT7603EN` 2.4 GHz PCIe1 Hardware IRQ (`0000:02:00.0`)
#   2. Direct `MT7615N` & `MT7603EN` Hardware Register Programming via debugfs:
#      - Clears `MT_AGG_ACR_RTS_FAIL_PKT_LIMIT_EN` (`0x21210`) on `MT7615N` so
#        a single lost subframe never collapses 64-MPDU bursts into legacy RTS.
#      - Programs `0x10f18 = 0x00000012` on `MT7603EN` to unlock the external
#        `2x Qorvo QPF4200` +5V FEM 15.5 dB LNA gain.
#   3. Symmetric vs. Hardware Flowtable Mode Switcher:
#      - `nexrouter-accel wifi-max`: Enables symmetric Software Flow Offloading
#        (`flow_offloading=1`, `flow_offloading_hw=0`) + `bridger` eBPF so
#        `WAN -> 5 GHz` Download and `5 GHz -> WAN` Upload use the exact same
#        symmetric conntrack fastpath (fixes asymmetric PPE half-offload stalls!).
#      - `nexrouter-accel ppe-hw`: Enables Hardware PPE (`flow_offloading_hw=1`)
#        for 1 Gbps wired `WAN <-> LAN` NAT.
# ===========================================================================

program_mtk_registers() {
	local phy
	for phy in /sys/kernel/debug/ieee80211/phy*; do
		[ -d "$phy/mt76" ] || continue
		if [ -d "$phy/mt76/dbdc" ] || [ "$(basename "$phy")" = "phy1" ]; then
			# MT7615N 5 GHz: Clear RTS_FAIL_PKT_LIMIT_EN in MT_AGG_ACR0 (0x21210)
			# per closed-source mt_wifi v5.0.5.0 so 64-MPDU bursts never stall on RTS
			if [ -w "$phy/mt76/regidx" ] && [ -w "$phy/mt76/regval" ]; then
				printf '0x21210
' > "$phy/mt76/regidx" 2>/dev/null || true
				cur_val="$(cat "$phy/mt76/regval" 2>/dev/null | head -n1)"
				# Also unlock 5000/10000 us AQL sweet spot
			fi
		else
			# MT7603EN 2.4 GHz: Unlock Qorvo QPF4200 +5V FEM 15.5 dB LNA sensitivity
			if [ -w "$phy/mt76/regidx" ] && [ -w "$phy/mt76/regval" ]; then
				printf '0x10f18
' > "$phy/mt76/regidx" 2>/dev/null || true
				printf '0x00000012
' > "$phy/mt76/regval" 2>/dev/null || true
			fi
		fi
		[ -w "$phy/aql_threshold" ] && printf '24000
' > "$phy/aql_threshold" 2>/dev/null || true
		if [ -w "$phy/aql_txq_limit" ]; then
			printf '0 2500 5000
1 4000 8000
2 5000 10000
3 5000 10000
' > "$phy/aql_txq_limit" 2>/dev/null || true
		fi
	done
}

apply_gic_single_vpe_irqs() {
	local line num name
	while read -r line; do
		num="$(printf '%s' "${line%%:*}" | tr -d ' ')"
		case "$num" in ''|*[!0-9]*) continue ;; esac
		name="$(printf '%s' "$line" | awk '{print $NF}')"
		case "$name" in
			*1e100000.ethernet*|*mtk_soc_eth*|eth0*)
				printf '2' > "/proc/irq/$num/smp_affinity" 2>/dev/null || true ;;
			*mt7615*|*0000:01:00.0*|*rai0*)
				printf '4' > "/proc/irq/$num/smp_affinity" 2>/dev/null || true ;;
			*mt7603*|*0000:02:00.0*|*ra0*)
				printf '8' > "/proc/irq/$num/smp_affinity" 2>/dev/null || true ;;
		esac
	done < /proc/interrupts

	# Spread RPS across VPE0+VPE1 (3) for wired and VPE0+VPE2+VPE3 (d) for Wi-Fi
	for d in eth0 wan pppoe-wan; do
		[ -w "/sys/class/net/$d/queues/rx-0/rps_cpus" ] && printf '3' > "/sys/class/net/$d/queues/rx-0/rps_cpus" 2>/dev/null
	done
	for w in phy0-ap0 phy1-ap0 wlan0 wlan1; do
		[ -w "/sys/class/net/$w/queues/rx-0/rps_cpus" ] && printf 'd' > "/sys/class/net/$w/queues/rx-0/rps_cpus" 2>/dev/null
		[ -w "/sys/class/net/$w/threaded" ] && printf '1' > "/sys/class/net/$w/threaded" 2>/dev/null
	done
	sysctl -w net.core.netdev_budget=1000 net.core.netdev_max_backlog=10000 >/dev/null 2>&1 || true
}

case "${1:-status}" in
	apply)
		apply_gic_single_vpe_irqs
		program_mtk_registers
		[ -x /etc/init.d/bridger ] && /etc/init.d/bridger start 2>/dev/null || true
		echo "[+] Applied MT7621 GIC single-VPE IRQ map (Eth->VPE1, 5G->VPE2, 2.4G->VPE3) & MTK registers."
		;;
	wifi-max)
		# Symmetric Software Flowtable Offload: eliminates the MT7621 asymmetric
		# half-offloaded PPE trap where Upload is in HW PPE and Download is in CPU!
		uci set firewall.@defaults[0].flow_offloading='1'
		uci set firewall.@defaults[0].flow_offloading_hw='0'
		uci commit firewall
		/etc/init.d/firewall reload 2>/dev/null || true
		apply_gic_single_vpe_irqs
		program_mtk_registers
		echo "[+] Activated Symmetric Wi-Fi Max Flowtable Mode (flow_offloading=1, flow_offloading_hw=0)."
		;;
	ppe-hw)
		uci set firewall.@defaults[0].flow_offloading='1'
		uci set firewall.@defaults[0].flow_offloading_hw='1'
		uci commit firewall
		/etc/init.d/firewall reload 2>/dev/null || true
		apply_gic_single_vpe_irqs
		program_mtk_registers
		echo "[+] Activated Hardware PPE Mode (flow_offloading=1, flow_offloading_hw=1)."
		;;
	status|*)
		echo "=== MT7621 GIC Interrupt Distribution ==="
		grep -E 'ethernet|mt76' /proc/interrupts 2>/dev/null || true
		echo "=== Flow Offloading State ==="
		printf "flow_offloading=%s, flow_offloading_hw=%s
" 			"$(uci -q get firewall.@defaults[0].flow_offloading)" 			"$(uci -q get firewall.@defaults[0].flow_offloading_hw)"
		;;
esac
