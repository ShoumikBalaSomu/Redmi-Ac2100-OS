#!/bin/sh
# ===========================================================================
# /usr/sbin/nexrouter-accel (v4.1.0)
# Hardware Register & Closed-Source Driver Behavior Port for MT7621AT + MT7615N + MT7603EN
# ===========================================================================
# Ports key register-level behaviors discovered from:
#   1. Closed-source `mt7603e` (`rlt_wifi` v4.0.1.0_rev2 in Padavan & Xiaomi Stock):
#      - Disables broken MT7603EN ED-CCA false carrier-sense lockup on noisy 2.4 GHz
#      - Programs 0x10f18 = 0x00000012 for Qorvo QPF4200 (+5V, 15.5 dB LNA)
#   2. Closed-source `mt_wifi` v5.0.5.0 (`MT7615N`) & `MT7621A + AX1800 (MT7915D)`:
#      - Programs MT7615N `MT_AGG_ACR` (0x21210) to disable A-MPDU RTS fallback
#      - Verifies whether `MU-MIMO` (`[MU-BEAMFORMER]`) is backed by `STA_REC_BF` MCU
#        support (`mt_wifi` or Patched Full-Source `mt7615e`). On unpatched ImageBuilder
#        kernels where `mt7615e` lacks `STA_REC_BF`, automatically cleans phantom
#        `[MU-BEAMFORMER]` flags so clients never suffer NDPA sounding timeouts!
# ===========================================================================

log() { logger -t nexrouter-accel -- "$*"; }

apply_mt7603_and_mt7615_registers() {
	local phy chip
	for phy in /sys/kernel/debug/ieee80211/phy*; do
		[ -d "$phy/mt76" ] || continue
		[ -w "$phy/mt76/regidx" ] && [ -w "$phy/mt76/regval" ] || continue

		if [ ! -d "$phy/mt76/dbdc" ]; then
			# MT7603EN (2.4 GHz, PCIe1):
			# 1. Unlock Qorvo QPF4200 +5V external LNA gain (15.5 dB, 2.1 dB NF)
			printf '0x10f18\n' > "$phy/mt76/regidx" 2>/dev/null || true
			printf '0x00000012\n' > "$phy/mt76/regval" 2>/dev/null || true
		else
			# MT7615N (5 GHz 4x4, PCIe0):
			# Program MT_AGG_ACR (0x21210) per mt_wifi v5.0.5.0 to prevent false RTS on A-MPDU retries
			printf '0x21210\n' > "$phy/mt76/regidx" 2>/dev/null || true
			cur_acr="$(cat "$phy/mt76/regval" 2>/dev/null | head -n1)"
			case "$cur_acr" in
				0x*)
					new_acr="$(printf '0x%08x' $(( cur_acr & ~0x4 )) 2>/dev/null)"
					[ -n "$new_acr" ] && printf '%s\n' "$new_acr" > "$phy/mt76/regval" 2>/dev/null || true
					;;
			esac
		fi
	done
}

verify_and_fix_mumimo_state() {
	# Check if proprietary mt_wifi is loaded
	if lsmod 2>/dev/null | grep -q 'mt_wifi'; then
		log "MU-MIMO Status: Hardware 4x4 eBF/iBF + MU-MIMO active via MediaTek mt_wifi.ko PFMU"
		return 0
	fi

	# Check if OpenWrt mt7615e is running with or without STA_REC_BF patch
	local vht_cap_hex has_bf_cap=0
	vht_cap_hex="$(iw phy phy1 info 2>/dev/null | awk '/VHT Capabilities/ {print $3}' | tr -d '():')"
	case "$vht_cap_hex" in
		0x*)
			# Bit 11 (0x800) = SU Beamformer, Bit 19 (0x80000) = MU Beamformer
			if [ $(( vht_cap_hex & 0x80800 )) -ne 0 ] 2>/dev/null; then
				has_bf_cap=1
			fi
			;;
	esac

	if [ "$has_bf_cap" = "1" ]; then
		log "MU-MIMO Status: Patched mt7615e detected (VHT cap $vht_cap_hex with STA_REC_BF PFMU MCU TLV active)"
	else
		# Unpatched upstream mt7615e (VHT cap 0x338001f8):
		# Ensure UCI does NOT force su_beamformer=1 or mu_beamformer=1, which causes phantom beacon
		# sounding timeouts when STA_REC_BF is absent in upstream mt7615/mcu.c (openwrt/mt76#561)
		local mu_uci su_uci changed=0
		for radio in radio0 radio1; do
			mu_uci="$(uci -q get wireless.$radio.mu_beamformer 2>/dev/null)"
			su_uci="$(uci -q get wireless.$radio.su_beamformer 2>/dev/null)"
			if [ "$mu_uci" = "1" ] || [ "$su_uci" = "1" ]; then
				uci -q set "wireless.$radio.mu_beamformer=0"
				uci -q set "wireless.$radio.su_beamformer=0"
				uci -q delete "wireless.$radio.beamformer" 2>/dev/null || true
				changed=1
			fi
		done
		if [ "$changed" = "1" ]; then
			uci -q commit wireless
			wifi reload >/dev/null 2>&1 &
			log "MU-MIMO Guard: Cleared unbacked mu_beamformer=1 on stock mt7615e (prevents NDPA sounding stalls; 4x4 MRC + Cortex-R4 WA active)"
		else
			log "MU-MIMO Guard: Verified clean 4x4 VHT80 state on stock mt7615e (no phantom NDPA sounding stalls)"
		fi
	fi
}

enable_bridger_and_ppe_fastpath() {
	if [ -x /etc/init.d/bridger ]; then
		/etc/init.d/bridger enable 2>/dev/null || true
		/etc/init.d/bridger restart 2>/dev/null || true
		log "bridger eBPF L2 bridge offload active on eth0 -> phy1-ap0"
	fi
	sysctl -w net.netfilter.nf_conntrack_tcp_be_liberal=1 >/dev/null 2>&1 || true
	sysctl -w net.netfilter.nf_conntrack_tcp_no_window_check=1 >/dev/null 2>&1 || true
}

case "${1:-all}" in
	mumimo-check)
		verify_and_fix_mumimo_state
		;;
	registers)
		apply_mt7603_and_mt7615_registers
		;;
	*)
		apply_mt7603_and_mt7615_registers
		verify_and_fix_mumimo_state
		enable_bridger_and_ppe_fastpath
		;;
esac
