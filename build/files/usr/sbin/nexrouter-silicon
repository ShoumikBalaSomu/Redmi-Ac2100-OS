#!/usr/bin/ucode
// ===========================================================================
// /usr/sbin/nexrouter-silicon (v9.2.0 — Zero-Freeze Native ucode Silicon Engine)
// ===========================================================================
// Executes in a single persistent bytecode process on OpenWrt's built-in
// `ucode` VM (`ucode-mod-fs`) with ZERO fork()/execve() overhead.
//
// Key Stability Fixes in v9.2.0:
//   1. PCIe 1.1 Root Complex 5-Bit Tag Compatibility (`/sys/bus/pci/devices/*/config`):
//      The MT7621AT PCIe Root Complex (`1e140000.pcie`) only supports 5-bit TLP
//      tags (tags 0..31) and 128B MPS. Setting `EXT_TAG` (`0x0100`, 8-bit tags)
//      caused PCIe Completion Timeouts as soon as tag 32 was issued (~2 mins
//      after boot), freezing Wi-Fi DMA while the N9 MCU kept broadcasting SSIDs!
//      -> Explicitly clears `EXT_TAG` (`& ~0x0100`) and programs safe 256B MRRS
//         (`0x1000`) + Relaxed Ordering (`0x0010`).
//   2. MT7615N WPDMA Zero-Stall Interrupt Mode (`0x4210 = 0x00000000`):
//      Ensures `MT_DELAY_INT_CFG` (`0x4210`) is `0x00000000` so EAPOL 4-way
//      handshake frames are delivered immediately without waiting for 16-packet
//      delayed interrupt coalescing.
//   3. Preserves MT7603EN 2.4 GHz PHY AGC Register (`0x10f18`):
//      Never overwrites `0x10f18` with `0x00000012` (which zeroed bits [31:8]
//      and deafened 2.4 GHz RX!).
// ===========================================================================

import * as fs from 'fs';

function write_sysfs(path, val) {
	let f = fs.open(path, 'w');
	if (!f) return false;
	f.write( sprintf('%s\n', val) );
	f.close();
	return true;
}

function read_sysfs(path) {
	let f = fs.open(path, 'r');
	if (!f) return null;
	let s = f.read('all');
	f.close();
	return s ? trim(s) : null;
}

// 1. Safe PCIe Config-Space Optimizer (256B MRRS + Relaxed Order, NO 8-Bit ExtTag!)
function optimize_pcie_config_space(verbose) {
	let devs = fs.lsdir('/sys/bus/pci/devices');
	if (!devs) return 0;
	let count = 0;

	for (let bdf in devs) {
		let cfg_path = sprintf('/sys/bus/pci/devices/%s/config', bdf);
		let f = fs.open(cfg_path, 'r+');
		if (!f) continue;

		let raw = f.read(256);
		if (!raw || length(raw) < 64) {
			f.close();
			continue;
		}

		let cap_ptr = ord(raw, 0x34) & 0xfc;
		let guard = 0;
		while (cap_ptr >= 0x40 && cap_ptr < 0xf0 && guard++ < 32) {
			let cap_id = ord(raw, cap_ptr);
			let next_ptr = ord(raw, cap_ptr + 1) & 0xfc;
			if (cap_id == 0x10) { // PCI_CAP_ID_EXP
				let lo = ord(raw, cap_ptr + 8);
				let hi = ord(raw, cap_ptr + 9);
				let devctl = lo | (hi << 8);
				// Clear READRQ (0x7000) AND clear EXT_TAG (0x0100) for MT7621AT 5-bit tag RC!
				// Set safe 256B MRRS (0x1000) | RELAX_EN (0x0010)
				let new_devctl = (devctl & ~(0x7000 | 0x0100)) | 0x1000 | 0x0010;
				if (new_devctl != devctl) {
					f.seek(cap_ptr + 8);
					f.write(chr(new_devctl & 0xff) + chr((new_devctl >> 8) & 0xff));
				}
				if (verbose) {
					printf('PCIe [%s] Cap@0x%02x DEVCTL: 0x%04x -> 0x%04x (256B MRRS + RelaxedOrder, 5-Bit Tag Safe)\n',
						bdf, cap_ptr, devctl, new_devctl);
				}
				count++;
				break;
			}
			cap_ptr = next_ptr;
		}
		f.close();
	}
	return count;
}

// 2. Safe MT7615N & MT7603EN Silicon Register Guard (Linux 6.6 & 6.18.55)
function optimize_mt76_registers(verbose) {
	let phys = fs.lsdir('/sys/kernel/debug/ieee80211');
	if (!phys) return 0;
	let count = 0;

	for (let p in phys) {
		if (substr(p, 0, 3) != 'phy') continue;
		let base = sprintf('/sys/kernel/debug/ieee80211/%s/mt76', p);
		let regidx = base + '/regidx';
		let regval = base + '/regval';
		if (!fs.stat(regidx) || !fs.stat(regval)) continue;

		if (fs.stat(base + '/dbdc')) {
			// MT7615N (5 GHz 4x4, PCIe0):
			// Ensure MT_DELAY_INT_CFG (0x4210) is 0x00000000 so WPDMA never stalls handshakes
			write_sysfs(regidx, '0x4210');
			write_sysfs(regval, '0x00000000');
			if (verbose) {
				printf('MT7615N  [%s] 0x4210=0x00000000 (Zero-Stall Immediate WPDMA IRQ Active)\n', p);
			}
		} else {
			if (verbose) {
				printf('MT7603EN [%s] Factory PHY AGC & Qorvo QPF4200 +5V LNA Calibration Intact\n', p);
			}
		}
		count++;
	}
	return count;
}

// 3. In-Memory Discrete Simulated Bifurcation (dSB) Ising Solver (Zero Forks!)
function solve_qio_ising(wrssi, retry, stas, kbps) {
	let Q16 = 65536;
	let dt = 8192;
	let a0 = 65536;
	let x = [ 0, 0, 0, 0 ];
	let y = [ 1024, -1024, 512, -512 ];
	let h = [
		((wrssi + 68) * 2048) - ((stas > 1) ? (stas * 16384) : -24576),
		((wrssi + 65) * 2048) - (retry * 1024),
		(25 - retry) * 2048,
		(kbps > 10000) ? 32768 : 16384
	];
	let J = [
		[ 0, 16384, 24576, 8192 ],
		[ 16384, 0, 12288, 4096 ],
		[ 24576, 12288, 0, 8192 ],
		[ 8192, 4096, 8192, 0 ]
	];

	for (let step = 0; step < 32; step++) {
		let p = int((step * Q16) / 32);
		for (let i = 0; i < 4; i++) {
			let c = h[i];
			for (let j = 0; j < 4; j++) {
				if (i != j) {
					c += J[i][j] * ((x[j] >= 0) ? 1 : -1);
				}
			}
			let force = -int(((a0 - p) * x[i]) / Q16) + int(c / 4);
			y[i] += int((dt * force) / Q16);
			x[i] += int((dt * y[i]) / Q16);
			if (x[i] > Q16)  { x[i] = Q16;  y[i] = 0; }
			if (x[i] < -Q16) { x[i] = -Q16; y[i] = 0; }
		}
	}

	let s0 = (x[0] >= 0) ? 1 : -1;
	let s1 = (x[1] >= 0) ? 1 : -1;
	let s2 = (x[2] >= 0) ? 1 : -1;

	let mode = (stas >= 2)
		? 'SYNTHETIC_WIFI6_sOFDMA_MICRO_TDMA'
		: ((s0 > 0) ? 'QIO_PEAK_AGGREGATION_1733M' : 'QIO_BEAMFORM_WALLBREAKER');
	let aql = (stas >= 2) ? 2500 : ((s0 > 0) ? 5000 : 4000);
	let rts = 2347;
	let cca = (s1 > 0) ? -68 : ((wrssi <= -72) ? -98 : -82);

	return sprintf('%s|%d|%d|%d', mode, aql, rts, cca);
}

let cmd = ARGV[0] || 'apply';
if (cmd == 'qio') {
	let wrssi = int(ARGV[1] || '-55');
	let retry = int(ARGV[2] || '2');
	let stas  = int(ARGV[3] || '1');
	let kbps  = int(ARGV[4] || '50000');
	printf('%s\n', solve_qio_ising(wrssi, retry, stas, kbps));
} else {
	let verbose = (cmd == 'status');
	let pcie_n = optimize_pcie_config_space(verbose);
	let phy_n  = optimize_mt76_registers(verbose);
	if (verbose) {
		printf('NexRouter v9.2 Native ucode Silicon Engine: Tuned %d PCIe devices & %d PHYs (Zero-Freeze Mode).\n', pcie_n, phy_n);
	}
}
