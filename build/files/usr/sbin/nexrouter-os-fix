#!/bin/sh
# ===========================================================================
# /usr/sbin/nexrouter-os-fix (v9.2.0 — HyperOS Bug Fixer & Software Hardware)
# ===========================================================================
# Fixes fundamental OpenWrt OS bugs and synthesizes Software-Defined Hardware:
#   1. Clean `mac80211.sh` VHT80P80 & 2.4G `vendor_vht` support (never injects
#      duplicate `bss_load_update_period`/`chan_util_avg_period` lines that can
#      stall or reject `hostapd` reloads).
#   2. `NexPulse` Kernel `nftables` NPU: Pre-offload TCP SYN MSS clamping +
#      Zero-Jitter DSCP prioritization (`UDP<=220B -> EF`, `TCP<=160B -> CS6`).
#   3. `NexVault` Virtual USB Flash (`/etc/nexvault`) & RAM Drive (`/tmp/nexdrive`).
#   4. `DNSmasq` Zero-Drop DHCP binding (`nonwildcard=0`) + `nex.router` domain.
# ===========================================================================

log() { logger -t nexrouter-os-fix -- "$*"; }

# 1. Cleanly patch /lib/netifd/wireless/mac80211.sh without duplicate hostapd BSS options
fix_openwrt_mac80211_netifd_bugs() {
	local mac_sh="/lib/netifd/wireless/mac80211.sh"
	[ -f "$mac_sh" ] || return 0

	# If an older patch injected duplicate bss_load_update_period/chan_util_avg_period, restore .orig first
	if grep -q "chan_util_avg_period=600" "$mac_sh" 2>/dev/null && [ -f "${mac_sh}.orig" ]; then
		cp -f "${mac_sh}.orig" "$mac_sh" 2>/dev/null || true
	fi

	if ! grep -q "NEXROUTER_HYPEROS_MAC80211_V92" "$mac_sh" 2>/dev/null; then
		[ -f "${mac_sh}.orig" ] || cp -f "$mac_sh" "${mac_sh}.orig" 2>/dev/null || true
		sed -i '/bss_load_update_period=50/d; /chan_util_avg_period=600/d' "$mac_sh" 2>/dev/null || true
		if ! grep -q "config_add_string channel2" "$mac_sh" 2>/dev/null; then
			sed -i '/config_add_int .*channel/a \	config_add_string channel2\n\	config_add_boolean vendor_vht' "$mac_sh" 2>/dev/null || true
			sed -i 's/json_get_vars channel /json_get_vars channel channel2 vendor_vht /g' "$mac_sh" 2>/dev/null || true
		fi

		awk '
		/vht_oper_chwidth=/ && !done_vht {
			print $0
			print "\t\t# NEXROUTER_HYPEROS_MAC80211_V92: VHT80P80 support"
			print "\t\tif [ \"$htmode\" = \"VHT80P80\" ]; then"
			print "\t\t\tvht_oper_chwidth=3"
			print "\t\t\tvht_center_seg0=155"
			print "\t\t\t[ \"$channel\" = \"36\" ] && vht_center_seg0=42"
			print "\t\t\tvht_center_seg1=42"
			print "\t\t\t[ \"${channel2:-36}\" = \"149\" ] && vht_center_seg1=155"
			print "\t\t\tappend base_cfg \"vht_oper_centr_freq_seg1_idx=$vht_center_seg1\" \"$N\""
			print "\t\t\tappend base_cfg \"vht_capab=[VHT160-80PLUS80][SHORT-GI-160]\" \"$N\""
			print "\t\tfi"
			done_vht=1
			next
		}
		{ print $0 }
		' "$mac_sh" > "${mac_sh}.new" && mv -f "${mac_sh}.new" "$mac_sh"
		chmod 0755 "$mac_sh"
		log "Verified clean OpenWrt mac80211.sh (VHT80P80 + 2.4G vendor_vht, zero duplicate BSS options)"
	fi
}

# 2. Software-Defined NPU: Kernel nftables Zero-Jitter Gaming/VoIP DSCP & Pre-Offload MSS Clamping
configure_nexpulse_kernel_npu() {
	command -v nft >/dev/null 2>&1 || return 0
	local game_en
	game_en="$(uci -q get nexrouter.core.game_accel 2>/dev/null || echo 1)"

	nft delete table inet nexrouter_hyperos 2>/dev/null || true

	if [ "$game_en" != "1" ]; then
		nft -f - 2>/dev/null <<-'NFTEOF' || true
			table inet nexrouter_hyperos {
				chain mangle_forward {
					type filter hook forward priority mangle; policy accept;
					tcp flags syn tcp option maxseg size set rt mtu
				}
			}
		NFTEOF
		log "NexPulse: Pre-offload TCP MSS clamping active (Game DSCP NPU disabled)"
		return 0
	fi

	nft -f - 2>/dev/null <<-'NFTEOF' || true
		table inet nexrouter_hyperos {
			chain mangle_forward {
				type filter hook forward priority mangle; policy accept;
				tcp flags syn tcp option maxseg size set rt mtu
				ip protocol udp meta length <= 220 ip dscp set ef counter
				ip6 nexthdr udp meta length <= 220 ip6 dscp set ef counter
				ip protocol tcp meta length <= 160 ip dscp set cs6 counter
				ip6 nexthdr tcp meta length <= 160 ip6 dscp set cs6 counter
				ct bytes > 8388608 meta length > 1200 ip dscp set cs1 counter
				ct bytes > 8388608 meta length > 1200 ip6 dscp set cs1 counter
			}
		}
	NFTEOF
	log "NexPulse Kernel NPU active: UDP<=220B -> DSCP EF (AC_VO), TCP<=160B -> CS6, Bulk>8MB -> CS1 + MSS clamp"
}

# 3. Software-Defined Virtual USB Drive (`NexVault` Flash + `NexDrive` ZRAM RAM-Disk)
configure_nexvault_virtual_usb() {
	local vault_en
	vault_en="$(uci -q get nexrouter.core.nexvault_enabled 2>/dev/null || echo 1)"
	mkdir -p /etc/nexvault/public /tmp/nexdrive

	if [ ! -f /etc/nexvault/README_NEXVAULT.txt ]; then
		cat <<-'VEOF' > /etc/nexvault/README_NEXVAULT.txt
			========================================================================
			NexVault Virtual USB Storage (Software-Defined Flash & RAM Drive)
			========================================================================
			  1. /etc/nexvault  — Persistent Flash Vault (survives reboots & sysupgrades!)
			  2. /tmp/nexdrive  — High-Speed Compressed RAM Drive (400+ MB/s scratch space)

			Manage files directly in your browser at:
			  http://192.168.1.1/cgi-bin/luci/admin/system/filemanager
		VEOF
	fi

	if [ -f /etc/sysupgrade.conf ] && ! grep -q '^/etc/nexvault' /etc/sysupgrade.conf 2>/dev/null; then
		printf '/etc/nexvault\n' >> /etc/sysupgrade.conf
	fi

	if [ "$vault_en" = "1" ]; then
		ln -sfn /etc/nexvault/public /www/nexvault 2>/dev/null || true
		ln -sfn /tmp/nexdrive /etc/nexvault/ramdrive 2>/dev/null || true
	else
		rm -f /www/nexvault 2>/dev/null || true
	fi
	log "NexVault Virtual USB active: /etc/nexvault (Persistent UBIFS) + /tmp/nexdrive (High-Speed RAM Disk)"
}

# 4. Fix DNSmasq Zero-Drop DHCP Binding (`nonwildcard=0`), Local Router Domains (`nex.router`), and Optional IPv6 AAAA Filter
configure_dns_and_local_domains() {
	local filter_aaaa lan_ip changed=0
	filter_aaaa="$(uci -q get nexrouter.core.filter_aaaa 2>/dev/null || echo 0)"
	lan_ip="$(uci -q get network.lan.ipaddr 2>/dev/null || echo 192.168.1.1)"

	# CRITICAL: Ensure nonwildcard=0 so dnsmasq never unbinds from br-lan during interface events!
	if [ "$(uci -q get dhcp.@dnsmasq[0].nonwildcard 2>/dev/null)" != "0" ]; then
		uci -q set "dhcp.@dnsmasq[0].nonwildcard=0"
		uci -q set "dhcp.lan.force=1"
		changed=1
	fi

	if [ "$(uci -q get dhcp.@dnsmasq[0].filter_aaaa 2>/dev/null)" != "$filter_aaaa" ]; then
		uci -q set "dhcp.@dnsmasq[0].filter_aaaa=$filter_aaaa"
		uci -q set "dhcp.@dnsmasq[0].dnsforwardmax=1024"
		changed=1
	fi

	if ! grep -q 'nex.router' /etc/hosts 2>/dev/null; then
		printf '%s nex.router my.router nexrouter.lan\n' "$lan_ip" >> /etc/hosts
		changed=1
	fi

	if [ "$changed" = "1" ]; then
		uci -q commit dhcp
		/etc/init.d/dnsmasq reload >/dev/null 2>&1 || true
	fi
}

case "${1:-all}" in
	mac80211)
		fix_openwrt_mac80211_netifd_bugs
		;;
	npu|qos)
		configure_nexpulse_kernel_npu
		;;
	vault)
		configure_nexvault_virtual_usb
		;;
	dns)
		configure_dns_and_local_domains
		;;
	status)
		echo "=== NexRouter v9.2 HyperOS Bug-Fix & Software-Defined Hardware Status ==="
		echo "1. OpenWrt mac80211.sh Fix : $(grep -q 'NEXROUTER_HYPEROS_MAC80211' /lib/netifd/wireless/mac80211.sh 2>/dev/null && echo 'CLEAN (vendor_vht + VHT80P80)' || echo 'STANDARD')"
		echo "2. NexPulse Kernel NPU     : $(nft list table inet nexrouter_hyperos >/dev/null 2>&1 && echo 'ACTIVE (Zero-Jitter DSCP EF + Pre-Offload MSS Clamp)' || echo 'INACTIVE')"
		echo "3. NexVault Virtual USB    : /etc/nexvault ($(df -h /etc 2>/dev/null | awk 'NR==2 {print $4}') free flash) + /tmp/nexdrive ($(df -h /tmp 2>/dev/null | awk 'NR==2 {print $4}') free RAM)"
		echo "4. Local Router Domains    : http://nex.router/nex/ & http://my.router/ (nonwildcard=0, filter_aaaa=$(uci -q get nexrouter.core.filter_aaaa 2>/dev/null || echo 0))"
		;;
	*)
		fix_openwrt_mac80211_netifd_bugs
		configure_nexpulse_kernel_npu
		configure_nexvault_virtual_usb
		configure_dns_and_local_domains
		;;
esac
