#!/bin/sh
# ===========================================================================
# nexrouter-vht80p80 (v5.1) — Smart VHT80P80 (80+80 MHz) & VHT80 Controller
# ===========================================================================
MAC80211_SH="/lib/netifd/wireless/mac80211.sh"

patch_mac80211_sh() {
	[ -f "$MAC80211_SH" ] || return 1
	grep -q "VHT80P80" "$MAC80211_SH" 2>/dev/null && return 0

	cp -f "$MAC80211_SH" "${MAC80211_SH}.bak" 2>/dev/null || true
	sed -i '/config_add_int .*channel/a \	config_add_string channel2' "$MAC80211_SH" 2>/dev/null || true
	sed -i 's/json_get_vars channel /json_get_vars channel channel2 /g' "$MAC80211_SH" 2>/dev/null || true

	awk '
	/vht_oper_chwidth=/ && !done {
		print $0
		print "\t\tif [ \"$htmode\" = \"VHT80P80\" ]; then"
		print "\t\t\tvht_oper_chwidth=3"
		print "\t\t\tvht_center_seg0=155"
		print "\t\t\t[ \"$channel\" = \"36\" ] && vht_center_seg0=42"
		print "\t\t\tvht_center_seg1=42"
		print "\t\t\t[ \"${channel2:-36}\" = \"149\" ] && vht_center_seg1=155"
		print "\t\t\tappend base_cfg \"vht_oper_centr_freq_seg1_idx=$vht_center_seg1\" \"$N\""
		print "\t\t\tappend base_cfg \"vht_capab=[VHT160-80PLUS80][SHORT-GI-160]\" \"$N\""
		print "\t\tfi"
		done=1
		next
	}
	{ print $0 }
	' "$MAC80211_SH" > "${MAC80211_SH}.new" && mv -f "${MAC80211_SH}.new" "$MAC80211_SH"
	chmod 0755 "$MAC80211_SH"
}

find_5g_radio() {
	local dev band
	for dev in $(uci -q show wireless | grep -o 'wireless\.radio[0-9]' | sort -u | cut -d. -f2); do
		band="$(uci -q get wireless.$dev.band 2>/dev/null)"
		[ "$band" = "5g" ] && { printf '%s' "$dev"; return 0; }
	done
	printf 'radio1'
}

case "${1:-status}" in
	enable)
		patch_mac80211_sh
		r5="$(find_5g_radio)"
		uci -q set "wireless.$r5.country=US"
		uci -q set "wireless.$r5.channel=149"
		uci -q set "wireless.$r5.channel2=36"
		uci -q set "wireless.$r5.htmode=VHT80P80"
		uci -q commit wireless
		wifi reload
		sleep 6
		if ! iw dev phy1-ap0 info 2>/dev/null | grep -qE "80\+80|160 MHz"; then
			logger -t nexrouter-vht80p80 "Driver rejected VHT80P80; auto-restoring rock-solid VHT80 on Ch 149"
			uci -q set "wireless.$r5.htmode=VHT80"
			uci -q delete "wireless.$r5.channel2" 2>/dev/null || true
			uci -q commit wireless
			wifi reload
		fi
		;;
	vht80)
		r5="$(find_5g_radio)"
		uci -q set "wireless.$r5.htmode=VHT80"
		uci -q set "wireless.$r5.channel=149"
		uci -q delete "wireless.$r5.channel2" 2>/dev/null || true
		uci -q commit wireless
		wifi reload
		;;
	*)
		iw dev phy1-ap0 info 2>/dev/null || true
		;;
esac
