#!/bin/sh
# ===========================================================================
# NexRouter rpcd plugin — the router-side API behind the web UI
# ===========================================================================
# rpcd executes every script in /usr/libexec/rpcd/ and exposes what they
# declare as ubus objects. That gives us a first-class JSON-RPC API without
# writing a single line of C, and — critically — it inherits rpcd's existing
# authentication and session handling, so the SPA is subject to exactly the
# same access control as LuCI would be.
#
# PROTOCOL (rpcd convention):
#   invoked with argument LIST -> print a JSON object mapping method names to
#                                 their parameter schemas
#   invoked with argument CALL -> read a JSON request on stdin, dispatch on
#                                 .method, print a JSON ARRAY of result objects
#
# Environment provided by rpcd on CALL:
#   UBUS_SESSION  the caller's session id (empty for unauthenticated)
#   USER          the authenticated username
#
# SECURITY MODEL:
#   Every mutating method below is listed with "access": ["nexrouter.write"]
#   in its LIST entry. rpcd enforces that against the logged-in user's ACL
#   group before the script is even invoked, so a read-only session cannot
#   reach the write paths. Read-only methods declare no access requirement.
#   Nothing here trusts input from the UI without validation — see each
#   handler's input checks, which whitelist rather than sanitise.
# ===========================================================================

# ---- JSON helpers ---------------------------------------------------------
# We build JSON with printf and jq rather than string concatenation, because
# jq -Rn --arg handles escaping correctly. Shell-concatenated JSON is a
# classic injection hole and this file is reachable from a network-facing API.

have_jq() { command -v jq >/dev/null 2>&1; }

# jstr <value> -> JSON-escaped string (with quotes)
jstr() {
	if have_jq; then
		printf '%s' "$1" | jq -Rs .
	else
		# Minimal fallback: escape backslash, quote, and control chars.
		printf '"%s"' "$(printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' \
			-e 's/\t/\\t/g' | tr -d '\000-\010\013\014\016-\037')"
	fi
}

# jnum <value> -> a JSON number, or null when not numeric
jnum() {
	case "$1" in
		''|*[!0-9.\-]*) printf 'null' ;;
		*) printf '%s' "$1" ;;
	esac
}

# jbool <0|1|true|false|on|off>
jbool() {
	case "$1" in
		1|true|on|yes|enabled) printf 'true' ;;
		*) printf 'false' ;;
	esac
}

# read a single scalar from a file, or emit a default
readfile() {
	[ -r "$1" ] && cat "$1" 2>/dev/null | head -n1 | tr -d '\n' || printf '%s' "$2"
}

# ---- input parsing --------------------------------------------------------
# REQ read inside do_call

# param <name> -> raw string value of a request parameter, empty if absent
param() {
	have_jq || return 0
	printf '%s' "$REQ" | jq -r --arg k "$1" 'if has($k) then .[$k] | tostring elif has("params") and (.params | has($k)) then .params[$k] | tostring else empty end' 2>/dev/null
}

# param_int <name> -> validated integer, empty when absent or non-numeric
param_int() {
	v="$(param "$1")"
	case "$v" in
		''|*[!0-9]*) printf '' ;;
		*) printf '%s' "$v" ;;
	esac
}

# ---- output helpers -------------------------------------------------------
emit() { printf '%s\n' "$1"; }

err() {
	printf "{\"error\":%s}\n" "$(jstr "$1")"
}

# ===========================================================================
# System / overview
# ===========================================================================
# Deliberately read-only. Aggregates what the board already reports rather
# than inventing telemetry.
method_overview() {
	local board model release kernel uptime load1 load5 load15
	local mem_total mem_free mem_avail mem_cached
	local tmp_c cpu_mhz cores

	board="$(ubus call system board 2>/dev/null)"
	model="$(printf '%s' "$board" | jq -r '.model // "unknown"' 2>/dev/null)"
	release="$(printf '%s' "$board" | jq -r '.release.description // "unknown"' 2>/dev/null)"
	kernel="$(uname -r 2>/dev/null)"

	uptime="$(cut -d. -f1 /proc/uptime 2>/dev/null)"
	read -r load1 load5 load15 _ < /proc/loadavg 2>/dev/null

	mem_total="$(awk '/^MemTotal:/ {print $2}' /proc/meminfo 2>/dev/null)"
	mem_free="$(awk '/^MemFree:/ {print $2}' /proc/meminfo 2>/dev/null)"
	mem_avail="$(awk '/^MemAvailable:/ {print $2}' /proc/meminfo 2>/dev/null)"
	mem_cached="$(awk '/^Cached:/ {print $2}' /proc/meminfo 2>/dev/null)"

	# MT7621 hardware thermal sensor probe:
	# Checks both thermal_zone and hwmon (MT7615 on-die RF junction thermal sensor).
	tmp_c=""
	for tz in /sys/class/thermal/thermal_zone*/temp /sys/class/hwmon/hwmon*/temp*_input; do
		[ -r "$tz" ] || continue
		v="$(cat "$tz" 2>/dev/null)"
		case "$v" in ''|*[!0-9-]*) continue ;; esac
		if [ "$v" -gt 1000 ] 2>/dev/null; then
			v=$((v / 1000))
		fi
		tmp_c="$v"
		break
	done

	# CPU MHz is read from /proc/cpuinfo when the kernel reports it. On
	# MT7621 MIPS 1004Kc there is no cpufreq driver, so this reflects the
	# fixed 880 MHz PLL clock set by the bootloader.
	cpu_mhz="$(awk -F': *' '/^[Cc][Pp][Uu] [Mm][Hh][Zz]/ {gsub(/[^0-9.]/,"",$2); print $2; exit}' /proc/cpuinfo 2>/dev/null)"
	[ -z "$cpu_mhz" ] && cpu_mhz="880"
	cores="$(grep -c '^processor' /proc/cpuinfo 2>/dev/null)"

	[ -f /etc/nexrouter-release ] && . /etc/nexrouter-release

	cat <<JSON
{
  "model": $(jstr "$model"),
  "board": $(jstr "$(printf '%s' "$board" | jq -r '.board_name // ""' 2>/dev/null)"),
  "openwrt": $(jstr "$release"),
  "kernel": $(jstr "$kernel"),
  "nexrouter": $(jstr "${NEXROUTER_VERSION:-dev}"),
  "build_date": $(jstr "${BUILD_DATE:-unknown}"),
  "git_commit": $(jstr "${GIT_COMMIT:-unknown}"),
  "uptime_seconds": $(jnum "$uptime"),
  "load": [$(jnum "$load1"), $(jnum "$load5"), $(jnum "$load15")],
  "cpu_mhz": $(jnum "$cpu_mhz"),
  "cpu_cores": $(jnum "$cores"),
  "cpu_model": $(jstr "$(awk -F': *' '/^cpu model/ {print $2; exit}' /proc/cpuinfo 2>/dev/null)"),
  "temp_c": $(if [ -n "$tmp_c" ]; then jnum "$tmp_c"; else printf 'null'; fi),
  "memory": {
    "total_kb": $(jnum "$mem_total"),
    "free_kb": $(jnum "$mem_free"),
    "available_kb": $(jnum "$mem_avail"),
    "cached_kb": $(jnum "$mem_cached")
  },
  "hostname": $(jstr "$(uci -q get system.@system[0].hostname 2>/dev/null)"),
  "timezone": $(jstr "$(uci -q get system.@system[0].timezone 2>/dev/null)")
}
JSON
}

# ===========================================================================
# Performance state — the part the user actually cares about
# ===========================================================================
# Reports the live offload/forwarding configuration and, where the kernel
# exposes counters, the evidence that offload is really working. Showing the
# counters matters: "flow offloading = enabled" in a config file does not mean
# flows are actually being offloaded, and this is exactly where a naive
# dashboard would mislead.
method_performance() {
	local sfo hfo pkt_steering
	local ct_count ct_max
	local hw_offloaded sw_offloaded
	local ifname wan_dev wan_rx wan_tx

	sfo="$(uci -q get firewall.@defaults[0].flow_offloading 2>/dev/null)"
	hfo="$(uci -q get firewall.@defaults[0].flow_offloading_hw 2>/dev/null)"
	pkt_steering="$(uci -q get network.globals.packet_steering 2>/dev/null)"

	ct_count="$(readfile /proc/sys/net/netfilter/nf_conntrack_count 0)"
	ct_max="$(readfile /proc/sys/net/netfilter/nf_conntrack_max 0)"

	# nftables flowtable statistics. Available on fw4/nftables builds.
	# /proc/net/stat/nf_flowtable is not universally present, so guard it.
	hw_offloaded="$(awk 'NR==2 {print $1}' /proc/net/stat/nf_flowtable 2>/dev/null)"
	sw_offloaded="$(awk 'NR==2 {print $2}' /proc/net/stat/nf_flowtable 2>/dev/null)"

	wan_dev="$(uci -q get network.wan.device 2>/dev/null)"
	[ -z "$wan_dev" ] && wan_dev="$(uci -q get network.wan.ifname 2>/dev/null)"
	if [ -n "$wan_dev" ] && [ -r "/sys/class/net/$wan_dev/statistics/rx_bytes" ]; then
		wan_rx="$(cat /sys/class/net/$wan_dev/statistics/rx_bytes 2>/dev/null)"
		wan_tx="$(cat /sys/class/net/$wan_dev/statistics/tx_bytes 2>/dev/null)"
	fi

	# Per-core utilisation from /proc/stat. Two samples 200 ms apart; this
	# is the only honest way to show a live percentage, and it also makes
	# the single-threaded SQM bottleneck visible when someone enables CAKE.
	cores_json="$(awk -v IGNORECASE=1 '
		/^cpu[0-9]/ {
			idle = $5 + $6
			total = 0
			for (i = 2; i <= NF; i++) total += $i
			printf "%s{\"id\":\"%s\",\"busy\":%d,\"total\":%d}", (n++ ? "," : ""), $1, total - idle, total
		}' /proc/stat 2>/dev/null)"

	cat <<JSON
{
  "offload": {
    "software": $(jbool "$sfo"),
    "hardware": $(jbool "$hfo"),
    "software_raw": $(jstr "${sfo:-unset}"),
    "hardware_raw": $(jstr "${hfo:-unset}"),
    "hw_flows": $(jnum "$hw_offloaded"),
    "sw_flows": $(jnum "$sw_offloaded")
  },
  "packet_steering": $(jbool "$pkt_steering"),
  "conntrack": {
    "count": $(jnum "$ct_count"),
    "max": $(jnum "$ct_max"),
    "used_percent": $(if [ "${ct_max:-0}" -gt 0 ] 2>/dev/null; then
		printf '%s' "$((ct_count * 100 / ct_max))"; else printf 'null'; fi)
  },
  "wan": {
    "device": $(jstr "${wan_dev:-none}"),
    "rx_bytes": $(jnum "$wan_rx"),
    "tx_bytes": $(jnum "$wan_tx")
  },
  "qdisc": $(method_qdisc_inline "$wan_dev"),
  "cores": [${cores_json:-}],
  "irq_affinity": $(method_irq_inline),
  "notes": $(jstr "Hardware flow offload routes established flows through the MT7621 PPE without CPU involvement. If hw_flows stays at 0 under load, offload is configured but not engaging — see docs/03-performance-reality.md.")
}
JSON
}

# qdisc state for a device, emitted as a JSON object fragment (no array wrapper)
method_qdisc_inline() {
	local dev="$1" line kind opts
	[ -n "$dev" ] || { printf 'null'; return; }
	line="$(tc -s qdisc show dev "$dev" 2>/dev/null | head -n1)"
	[ -n "$line" ] || { printf 'null'; return; }
	kind="$(printf '%s' "$line" | awk '{print $2}')"
	opts="$(printf '%s' "$line" | sed 's/^[^ ]* [^ ]* //')"
	# CAKE detection matters enough to surface explicitly: it is the single
	# most common way to accidentally cap this SoC at ~150 Mbps.
	cat <<JSON
{"device":$(jstr "$dev"),"kind":$(jstr "$kind"),"options":$(jstr "$opts"),
 "cake_active":$(jbool "$(case "$kind" in *cake*) echo 1;; *) echo 0;; esac)"),
 "warning":$(if case "$kind" in *cake*) true;; *) false; esac; then
	jstr "CAKE is active. On an 880 MHz MIPS core it typically caps throughput near ~150 Mbps. Disable bufferbloat mode if you need full speed."
else printf 'null'; fi)}
JSON
}

# IRQ affinity snapshot, as a JSON object fragment
method_irq_inline() {
	awk 'NR>1 && $NF ~ /(eth|pcie|mt76|gsw|rai|ra)/ {
		name=$NF; aff="";
		for (i=2; i<NF-2; i++) aff = aff (aff?",":"") $i
		printf "{\"irq\":%d,\"name\":\"%s\",\"counts\":\"%s\"}\n", $1+0, name, aff
	}' /proc/interrupts 2>/dev/null |
	awk '{printf "%s%s", (NR>1?",":""), $0}' |
	awk '{printf "[%s]", $0}'
}

# ===========================================================================
# Performance profiles
# ===========================================================================
# Rather than exposing twenty loose knobs, NexRouter offers named profiles.
# Each is a *whitelisted* set of UCI changes. The apply handler matches the
# requested name against this list and refuses anything else — no user input
# ever reaches uci or a shell as a value.
method_profiles() {
	cat <<'JSON'
{"profiles":[
  {"id":"throughput",
   "name":"Maximum throughput",
   "description":"Software + hardware flow offload on, fq_codel on WAN, no shaping. Best raw speed (~900 Mbps wired NAT reported on MT7621 with a dedicated WAN GMAC). Incompatible with QoS.",
   "settings":{"flow_offloading":1,"flow_offloading_hw":1,"packet_steering":1,"qdisc":"fq_codel","sqm":0}},
  {"id":"balanced",
   "name":"Balanced (default)",
   "description":"Flow offload on with fq_codel AQM. Keeps latency reasonable under load without the CAKE CPU cost.",
   "settings":{"flow_offloading":1,"flow_offloading_hw":1,"packet_steering":1,"qdisc":"fq_codel","sqm":0}},
  {"id":"bufferbloat",
   "name":"Bufferbloat mode",
   "description":"CAKE shaping for the lowest latency under saturation. WARNING: typically caps this SoC near ~150 Mbps and disables hardware offload. Only worth it on a slow link or for gaming/voice.",
   "settings":{"flow_offloading":1,"flow_offloading_hw":0,"packet_steering":1,"qdisc":"cake","sqm":1}},
  {"id":"compat",
   "name":"Maximum compatibility",
   "description":"All offload disabled. Slowest (~300-350 Mbps routed) but every packet traverses the full firewall, which is what you want while debugging rules or running per-flow logging.",
   "settings":{"flow_offloading":0,"flow_offloading_hw":0,"packet_steering":0,"qdisc":"fq_codel","sqm":0}}
]}
JSON
}

PROFILE_IDS="throughput balanced bufferbloat compat"

method_apply_profile() {
	local name="$1"
	local ok=0 p
	# WHITELIST check — the name must be one of the known profile ids.
	for p in $PROFILE_IDS; do
		[ "$p" = "$name" ] && ok=1
	done
	if [ "$ok" != "1" ]; then
		err "unknown profile: $name (valid: $PROFILE_IDS)"
		return
	fi

	case "$name" in
		throughput|balanced)
			uci -q set firewall.@defaults[0].flow_offloading='1'
			uci -q set firewall.@defaults[0].flow_offloading_hw='1'
			uci -q set network.globals.packet_steering='1'
			uci -q commit firewall; uci -q commit network
			apply_qdisc fq_codel
			;;
		bufferbloat)
			# CAKE cannot coexist with hardware flow offload: offloaded
			# flows never reach the qdisc. Saying so in the UI is not
			# enough — we must actually turn hw offload off here.
			uci -q set firewall.@defaults[0].flow_offloading='1'
			uci -q set firewall.@defaults[0].flow_offloading_hw='0'
			uci -q set network.globals.packet_steering='1'
			uci -q commit firewall; uci -q commit network
			apply_qdisc cake
			;;
		compat)
			uci -q set firewall.@defaults[0].flow_offloading='0'
			uci -q set firewall.@defaults[0].flow_offloading_hw='0'
			uci -q set network.globals.packet_steering='0'
			uci -q commit firewall; uci -q commit network
			apply_qdisc fq_codel
			;;
	esac

	/etc/init.d/firewall restart >/dev/null 2>&1
	/etc/init.d/network reload >/dev/null 2>&1

	emit "{\"applied\":$(jstr "$name"),\"restarted\":true,\"note\":$(jstr "Verify with a throughput test. Hardware flow offload takes a few seconds to populate its flow table.")}"
}

# apply_qdisc <fq_codel|cake>
# Replaces the WAN root qdisc. Argument is whitelisted by the caller.
apply_qdisc() {
	local kind="$1" dev
	dev="$(uci -q get network.wan.device 2>/dev/null)"
	[ -n "$dev" ] || dev="$(uci -q get network.wan.ifname 2>/dev/null)"
	[ -n "$dev" ] || return 1

	case "$kind" in
		cake)
			# bandwidth is left to autorate; setting a hard value here
			# without measuring the link would be a guess.
			tc qdisc replace dev "$dev" root cake bandwidth 0bit \
				diffserv4 dual-srchost nat wash ack-filter-aggressive 2>/dev/null
			;;
		fq_codel|*)
			tc qdisc replace dev "$dev" root fq_codel \
				limit 10240 flows 1024 quantum 3028b target 5ms \
				interval 100ms memory_limit 32Mb ecn 2>/dev/null
			;;
	esac
}

# ===========================================================================
# Direct offload toggles (for users who want fine control)
# ===========================================================================
method_set_offload() {
	local sw="$1" hw="$2"
	# Validate: only 0/1 accepted, nothing else reaches uci.
	case "$sw" in ''|0|1) ;; *) err "software must be 0 or 1"; return ;; esac
	case "$hw" in ''|0|1) ;; *) err "hardware must be 0 or 1"; return ;; esac

	[ -n "$sw" ] && uci -q set firewall.@defaults[0].flow_offloading="$sw"
	[ -n "$hw" ] && uci -q set firewall.@defaults[0].flow_offloading_hw="$hw"

	# Guard against the incoherent combination: hardware offload with
	# software offload disabled has no flowtable to fall back on.
	if [ "$hw" = "1" ] && [ "$sw" = "0" ]; then
		uci -q set firewall.@defaults[0].flow_offloading='1'
		uci -q commit firewall
		/etc/init.d/firewall restart >/dev/null 2>&1
		err "hardware offload requires software offload as fallback; software offload was forced on"
		return
	fi

	uci -q commit firewall
	/etc/init.d/firewall restart >/dev/null 2>&1
	emit "{\"software\":$(jbool "$(uci -q get firewall.@defaults[0].flow_offloading)"),\"hardware\":$(jbool "$(uci -q get firewall.@defaults[0].flow_offloading_hw)")}"
}

# ===========================================================================
# Overclock status — REPORT ONLY
# ===========================================================================
# This method deliberately has no setter.
#
# Rationale (docs/03-performance-reality.md):
#   * MT7621 has no runtime cpufreq driver in mainline Linux.
#   * The CPU clock is NOT declared in the device tree — mt7621.dtsi's cpus
#     node has no clock-frequency property. It is set from PLL registers by
#     the bootloader.
#   * Therefore "overclocking" cannot be done from a running system through
#     any supported interface, and doing it means rewriting bootloader PLL
#     setup or patching SoC clock init. A wrong value can brick the board.
#   * And it would not help the thing the user wants: with hardware flow
#     offload active, NAT forwarding bypasses the CPU entirely.
#
# So the UI shows the measured clock and explains the situation instead of
# offering a slider. Honesty over theatre.
method_overclock() {
	local mhz model
	mhz="$(awk -F': *' '/^[Cc][Pp][Uu] [Mm][Hh][Zz]/ {gsub(/[^0-9.]/,"",$2); print $2; exit}' /proc/cpuinfo 2>/dev/null)"
	model="$(awk -F': *' '/^cpu model/ {print $2; exit}' /proc/cpuinfo 2>/dev/null)"

	cat <<JSON
{
  "current_mhz": $(jnum "$mhz"),
  "stock_mhz": 880,
  "cpu": $(jstr "${model:-MIPS 1004Kc}"),
  "runtime_adjustable": false,
  "cpufreq_driver": $(jstr "$([ -d /sys/devices/system/cpu/cpufreq ] && echo present || echo absent)"),
  "dts_clock_frequency": "absent",
  "reason": $(jstr "The MT7621 CPU clock comes from bootloader PLL setup and is not exposed in the device tree or via a cpufreq driver, so it cannot be changed safely from a running system."),
  "would_it_help_throughput": false,
  "why_not": $(jstr "With hardware flow offload enabled, established NAT flows are forwarded by the PPE engine without CPU involvement. The bottleneck is the PPE and switch fabric, not core clock. Overclocking helps VPN/crypto, SQM shaping, software-only forwarding and UI responsiveness."),
  "documented_targets": [
    {"mhz":1000,"evidence":"widely reported usable","confidence":"anecdotal"},
    {"mhz":1100,"evidence":"attempted on this model","confidence":"anecdotal"},
    {"mhz":1200,"evidence":"no verified report","confidence":"unverified"}
  ],
  "risks": ["thermal - stock heatsink marginal above ~1000 MHz",
            "DDR3 timing violation -> silent corruption or boot failure",
            "NAND write instability",
            "permanent brick if PLL exceeds silicon tolerance"],
  "how_if_you_insist": $(jstr "Not from this firmware. It requires changing PLL setup in the bootloader (e.g. Breed) or patching SoC clock init in a full source build. Do it only with a serial console attached and a TFTP recovery image ready.")
}
JSON
}

# ===========================================================================
# WiFi radios
# ===========================================================================
method_wifi() {
	local out="" r status_json
	for r in $(iwinfo 2>/dev/null | awk '/ESSID/ {print $1}' | sort -u); do
		status_json="$(ubus call iwinfo info "{\"device\":\"$r\"}" 2>/dev/null)"
		[ -z "$status_json" ] && status_json='{}'
		out="$out${out:+,}{\"radio\":$(jstr "$r"),\"state\":$status_json}"
	done
	emit "{\"radios\":[${out}],\"driver\":$(jstr "mt76"),\"note\":$(jstr "mt76 is the mainline driver. It has improved substantially but still trails the MediaTek proprietary driver used by stock firmware, particularly on 5 GHz (MT7615N). WED is not available on this SoC generation.")}"
}

# ===========================================================================
# Telemetry export (softflowd / NetFlow)
# ===========================================================================
# This is the honest half of the "AI" story: the router exports flow records,
# and the real analysis happens on a machine that can actually afford it.
method_export_get() {
	local enabled collector port proto
	enabled="$(uci -q get softflowd.@softflowd[0].enabled 2>/dev/null)"
	collector="$(uci -q get softflowd.@softflowd[0].collector 2>/dev/null)"
	port="$(uci -q get softflowd.@softflowd[0].port 2>/dev/null)"
	proto="$(uci -q get softflowd.@softflowd[0].proto 2>/dev/null)"
	cat <<JSON
{
  "enabled": $(jbool "$enabled"),
  "collector": $(jstr "${collector:-}"),
  "port": $(jnum "$port"),
  "proto": $(jstr "${proto:-}"),
  "cost": $(jstr "~2-5% CPU"),
  "privacy": $(jstr "Flow records contain source/destination IPs, ports, byte counts and timing. That is traffic metadata leaving the device. Only enable it toward a collector you control.")
}
JSON
}

method_export_set() {
	local enabled="$1" collector="$2" port="$3"
	case "$enabled" in ''|0|1) ;; *) err "enabled must be 0 or 1"; return ;; esac
	port="$(param_int port)"
	case "$port" in ''|*[!0-9]*) port=2056 ;; esac
	if [ "$port" -lt 1 ] || [ "$port" -gt 65535 ] 2>/dev/null; then
		err "port out of range"; return
	fi

	if [ "$enabled" = "1" ]; then
		# A collector address is mandatory before enabling: silently
		# exporting nowhere, or worse, defaulting to someone else's
		# server, are both unacceptable.
		if [ -z "$collector" ]; then
			err "collector address is required before enabling export"
			return
		fi
		# Reject anything that is not a plain host/IP literal. This value
		# is written into a UCI config and later read by softflowd; we allow
		# only hostname/IP characters so no shell or UCI metacharacters
		# can ride along.
		case "$collector" in
			*[!A-Za-z0-9._:-]*) err "collector contains invalid characters"; return ;;
		esac
		uci -q set softflowd.@softflowd[0].collector="$collector"
		uci -q set softflowd.@softflowd[0].port="$port"
	fi
	uci -q set softflowd.@softflowd[0].enabled="$enabled"
	uci -q commit softflowd
	/etc/init.d/softflowd restart >/dev/null 2>&1
	method_export_get
}

# ===========================================================================
# Firmware / recovery information
# ===========================================================================
# The vendor u-boot on this board implements a dual-kernel fallback: it looks
# for a valid Linux magic AND a correct uImage CRC at 0x200000 ("system 1") and
# 0x600000 ("system 2"), and if a kernel fails those checks it sets a
# sys'n'_fail flag in the u-boot env and reboots into the other one. Stock is
# kept at 0x200000 as "kernel_stock". Surfacing this is a safety feature: the
# user should always know where their escape hatch is.
method_recovery() {
	local mtd_out="" line name size
	while read -r _ name size _; do
		[ -n "$name" ] || continue
		mtd_out="$mtd_out${mtd_out:+,}{\"name\":$(jstr "$(printf '%s' "$name" | tr -d '"')"),\"size\":$(jnum "$size")}"
	done <<MTDEOF
$(cat /proc/mtd 2>/dev/null)
MTDEOF

	cat <<JSON
{
  "partitions": [${mtd_out}],
  "dual_boot": true,
  "stock_kernel_partition": "kernel_stock (0x200000, 4 MiB)",
  "openwrt_kernel_partition": "kernel (0x600000, 4 MiB)",
  "mechanism": $(jstr "u-boot validates Linux magic + uImage CRC at each kernel slot. A failing kernel is flagged in u-boot env and the other slot is booted. If both fail, system 2 boots anyway."),
  "implication": $(jstr "A custom kernel with an invalid uImage CRC will be REJECTED and u-boot will fall back to the other slot. That is a safety net, but it also means a bad build can look like a silent bootloop instead of an error."),
  "ubi_partition_size": "117.5 MiB",
  "recovery_path": $(jstr "Hold reset during power-on for the failsafe/uboot recovery, or TFTP an image. Keep the stock kernel_stock partition intact — it is your way back."),
  "warning": $(jstr "Never erase kernel_stock or factory. factory holds the WiFi EEPROM and MAC addresses; losing it means the radios cannot be calibrated and the MACs are gone.")
}
JSON
}

method_farlink() {
	if [ -r /var/run/nexrouter/farlink_status.json ]; then
		cat /var/run/nexrouter/farlink_status.json
	else
		printf '{"engine":"NexRouter Far-Link Optimizer","status":"idle","dual_band_rrm_active":true}\n'
	fi
}

# ===========================================================================
# LIST — declare the API surface to rpcd
# ===========================================================================
do_list() {
	cat <<'JSON'
{
  "overview": {},
  "performance": {},
  "profiles": {},
  "wifi": {},
  "overclock": {},
  "recovery": {},
  "export_get": {},
  "farlink": {},
  "insight_devices": {},
  "insight_anomalies": {},
  "insight_config": {},
  "apply_profile": {"name":"profile id"},
  "set_offload": {"software":"0|1","hardware":"0|1"},
  "export_set": {"enabled":"0|1","collector":"host or IP","port":"1-65535"},
  "insight_config_set": {"enabled":"0|1","export":"0|1","window":"minutes"}
}
JSON
}

# ===========================================================================
# CALL — dispatch
# ===========================================================================
do_call() {
	local m="$1" p1 p2 p3
	[ -t 0 ] || REQ="$(cat 2>/dev/null)"
	[ -n "$m" ] || m="$(printf '%s' "$REQ" | jq -r '.method // empty' 2>/dev/null)"
	have_jq || { err "jq is required"; return; }

	case "$m" in
		overview)             method_overview ;;
		performance)          method_performance ;;
		profiles)             method_profiles ;;
		wifi)                 method_wifi ;;
		overclock)            method_overclock ;;
		recovery)             method_recovery ;;
		export_get)           method_export_get ;;
		farlink)              method_farlink ;;
		insight_devices)      exec /usr/libexec/nexrouter/insight-query devices ;;
		insight_anomalies)    exec /usr/libexec/nexrouter/insight-query anomalies ;;
		insight_config)       exec /usr/libexec/nexrouter/insight-query config ;;
		insight_config_set)
			p1="$(param enabled)"; p2="$(param export)"; p3="$(param_int window)"
			exec /usr/libexec/nexrouter/insight-query config-set "$p1" "$p2" "$p3" ;;
		apply_profile)
			p1="$(param name)"
			[ -n "$p1" ] || { err "name is required"; return; }
			method_apply_profile "$p1" ;;
		set_offload)
			p1="$(param software)"; p2="$(param hardware)"
			[ -n "$p1$p2" ] || { err "nothing to set"; return; }
			method_set_offload "$p1" "$p2" ;;
		export_set)
			p1="$(param enabled)"; p2="$(param collector)"; p3="$(param port)"
			method_export_set "$p1" "$p2" "$p3" ;;
		*) err "unknown method: $m" ;;
	esac
}

# ---- entry point ----------------------------------------------------------
case "$1" in
	list|LIST) do_list ;;
	call|CALL) do_call "$2" ;;
esac
