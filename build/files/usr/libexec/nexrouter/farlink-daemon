#!/bin/sh
# ===========================================================================
# NexRouter v3.7 AI-RF, Gigabit Download & Edge-Triggered Thermal Controller
# ===========================================================================
# Key v3.7 Fixes for Wireless Download Speed (600-850+ Mbps on 5 GHz):
#   1. Edge-Triggered `nl80211` / MCU Updates (Zero TX Queue Stalls):
#      Previously, calling `iw dev set txpower` and `iw phy set rts` every 3s
#      acquired the kernel `wiphy_lock` and paused the MT7615N Andes N9 MCU TX
#      aggregation rings 3-4 times during a 10-second Speedtest! Now `iw` and
#      `hostapd` calls execute ONLY when a state transition actually occurs.
#   2. Unthrottled A-MPDU Download Windows (`aql_txq_limit` 16,000-24,000 us)
#      and RTS disabled (`2347`) across Near and Mid-Range Beamforming regimes.
# ===========================================================================

STATE_FILE="/var/run/nexrouter/farlink_status.json"
BANDIT_STATE="/var/run/nexrouter/bandit_arms.tsv"
PREV_BYTES_FILE="/var/run/nexrouter/radio_bytes.prev"
STA_WEIGHT_CACHE="/var/run/nexrouter/sta_weights.cache"
mkdir -p /var/run/nexrouter
: > "$STA_WEIGHT_CACHE"

# Reset legacy throttled bandit arms if upgrading from v3.0-v3.4
if [ ! -s "$BANDIT_STATE" ] || grep -qE '	(2500	1536|24000	2347)	' "$BANDIT_STATE" 2>/dev/null; then
	cat << 'BEOF' > "$BANDIT_STATE"
0	PEAK_AGGREGATION_1733M	5000	2347	1	85000
1	BEAMFORM_BALANCED	4000	2347	1	82000
2	WALLBREAKER_LONG_RANGE	3000	1536	1	75000
3	DENSE_OBSS_SPATIAL_REUSE	2500	1536	1	75000
BEOF
fi

discover_ap() {
	local band_match="$1" obj iface freq
	for obj in $(ubus list 'hostapd.*' 2>/dev/null); do
		iface="${obj#hostapd.}"
		freq="$(ubus call "$obj" get_status 2>/dev/null | jq -r '.freq // 0' 2>/dev/null)"
		if [ "$band_match" = "5g" ] && [ "${freq:-0}" -ge 5000 ] 2>/dev/null; then
			printf '%s' "$iface"; return 0
		elif [ "$band_match" = "2g" ] && [ "${freq:-0}" -ge 2400 ] && [ "${freq:-0}" -lt 2500 ] 2>/dev/null; then
			printf '%s' "$iface"; return 0
		fi
	done
	return 1
}

LAST_RRM_SYNC=0
sync_rrm_neighbors() {
	local if_2g="$1" if_5g="$2" now
	[ -n "$if_2g" ] && [ -n "$if_5g" ] || return 0
	now="$(date +%s)"
	# Sync RRM neighbor reports once every 60s instead of every 3s
	[ $((now - LAST_RRM_SYNC)) -lt 60 ] && return 0
	LAST_RRM_SYNC="$now"

	local bssid_2g bssid_5g ssid_2g ssid_5g nr_2g nr_5g
	bssid_2g="$(cat "/sys/class/net/$if_2g/address" 2>/dev/null | tr 'A-F' 'a-f')"
	bssid_5g="$(cat "/sys/class/net/$if_5g/address" 2>/dev/null | tr 'A-F' 'a-f')"
	nr_2g="$(ubus call "hostapd.$if_2g" rrm_nr_get_own 2>/dev/null | jq -r '.value[2] // empty' 2>/dev/null)"
	nr_5g="$(ubus call "hostapd.$if_5g" rrm_nr_get_own 2>/dev/null | jq -r '.value[2] // empty' 2>/dev/null)"
	ssid_2g="$(ubus call "hostapd.$if_2g" rrm_nr_get_own 2>/dev/null | jq -r '.value[1] // "NexRouter_2.4G"' 2>/dev/null)"
	ssid_5g="$(ubus call "hostapd.$if_5g" rrm_nr_get_own 2>/dev/null | jq -r '.value[1] // "NexRouter_5G"' 2>/dev/null)"

	if [ -n "$bssid_2g" ] && [ -n "$nr_2g" ]; then
		ubus call "hostapd.$if_5g" rrm_nr_set "{"list":[["$bssid_2g","$ssid_2g","$nr_2g"]]}" 2>/dev/null
	fi
	if [ -n "$bssid_5g" ] && [ -n "$nr_5g" ]; then
		ubus call "hostapd.$if_2g" rrm_nr_set "{"list":[["$bssid_5g","$ssid_5g","$nr_5g"]]}" 2>/dev/null
	fi
}

LAST_APPLIED_AQL=""
LAST_APPLIED_RTS=""
LAST_APPLIED_CCA=""

apply_radio_arm_and_obss_pd() {
	local aql_us="$1" rts_b="$2" cca_ed_dbm="$3" phy aql_high
	aql_high=$((aql_us * 2))

	if [ "$aql_us" != "$LAST_APPLIED_AQL" ] || [ "$cca_ed_dbm" != "$LAST_APPLIED_CCA" ]; then
		for phy in /sys/kernel/debug/ieee80211/phy*; do
			[ -d "$phy" ] || continue
			if [ "$aql_us" != "$LAST_APPLIED_AQL" ] && [ -w "$phy/aql_txq_limit" ]; then
				printf '0 4000 8000
' > "$phy/aql_txq_limit" 2>/dev/null || true
				printf '1 8000 16000
' > "$phy/aql_txq_limit" 2>/dev/null || true
				printf '2 %s %s
' "$aql_us" "$aql_high" > "$phy/aql_txq_limit" 2>/dev/null || true
				printf '3 %s %s
' "$aql_us" "$aql_high" > "$phy/aql_txq_limit" 2>/dev/null || true
			fi
			if [ "$cca_ed_dbm" != "$LAST_APPLIED_CCA" ] && [ -w "$phy/mt76/scs_threshold" ]; then
				printf '%s
' "$cca_ed_dbm" > "$phy/mt76/scs_threshold" 2>/dev/null || true
			fi
		done
		LAST_APPLIED_AQL="$aql_us"
		LAST_APPLIED_CCA="$cca_ed_dbm"
	fi

	# Edge-triggered RTS update: NEVER call `iw phy set rts` unless RTS changed!
	if [ "$rts_b" != "$LAST_APPLIED_RTS" ]; then
		for phy_name in phy0 phy1; do
			iw phy "$phy_name" set rts "$rts_b" 2>/dev/null || true
		done
		LAST_APPLIED_RTS="$rts_b"
	fi
}

LAST_THERM_STATE=""
# Edge-triggered thermal guard: only calls `iw dev set txpower` when crossing 78°C / 73°C hysteresis!
check_thermal_guard() {
	local if_5g="$1" if_2g="$2" tz v temp_c=52 new_state
	for tz in /sys/class/hwmon/hwmon*/temp*_input /sys/class/thermal/thermal_zone*/temp; do
		[ -r "$tz" ] || continue
		v="$(cat "$tz" 2>/dev/null)"
		case "$v" in ''|*[!0-9-]*) continue ;; esac
		[ "$v" -gt 1000 ] 2>/dev/null && v=$((v / 1000))
		temp_c="$v"
		break
	done
	if [ "$temp_c" -ge 78 ] 2>/dev/null; then
		new_state="THERMAL_GUARD_24dBm"
	elif [ "$temp_c" -le 73 ] 2>/dev/null || [ -z "$LAST_THERM_STATE" ]; then
		new_state="FULL_POWER_26dBm"
	else
		new_state="$LAST_THERM_STATE"
	fi

	if [ "$new_state" != "$LAST_THERM_STATE" ]; then
		if [ "$new_state" = "THERMAL_GUARD_24dBm" ]; then
			[ -n "$if_5g" ] && iw dev "$if_5g" set txpower fixed 2400 2>/dev/null || true
			[ -n "$if_2g" ] && iw dev "$if_2g" set txpower fixed 2100 2>/dev/null || true
		else
			[ -n "$if_5g" ] && iw dev "$if_5g" set txpower fixed 2600 2>/dev/null || true
			[ -n "$if_2g" ] && iw dev "$if_2g" set txpower fixed 2300 2>/dev/null || true
		fi
		LAST_THERM_STATE="$new_state"
	fi
	printf '%s|%s' "$temp_c" "$new_state"
}

update_sta_airtime_if_changed() {
	local iface="$1" mac="$2" weight="$3" prev_w
	prev_w="$(grep "^${iface}:${mac}=" "$STA_WEIGHT_CACHE" 2>/dev/null | cut -d= -f2)"
	[ "$prev_w" = "$weight" ] && return 0
	grep -v "^${iface}:${mac}=" "$STA_WEIGHT_CACHE" > "$STA_WEIGHT_CACHE.tmp" 2>/dev/null || true
	printf '%s:%s=%s
' "$iface" "$mac" "$weight" >> "$STA_WEIGHT_CACHE.tmp"
	mv -f "$STA_WEIGHT_CACHE.tmp" "$STA_WEIGHT_CACHE"
	ubus call "hostapd.$iface" update_airtime "{"sta":"$mac","weight":$weight}" 2>/dev/null || true
}

ACTIVE_ARM=0
ACTIVE_ARM_NAME="PEAK_AGGREGATION_1733M"
ACTIVE_AQL=5000
ACTIVE_RTS=2347
OBSS_PD_MODE="ADAPTIVE_BALANCED"
CCA_ED_DBM=-82

while :; do
	enabled="$(uci -q get nexrouter.roaming.enabled 2>/dev/null || echo 1)"
	ai_bandit="$(uci -q get nexrouter.roaming.ai_bandit 2>/dev/null || echo 1)"
	interval="$(uci -q get nexrouter.roaming.interval 2>/dev/null || echo 3)"
	rssi_near="$(uci -q get nexrouter.roaming.rssi_ultra_near 2>/dev/null || echo -58)"
	rssi_mid="$(uci -q get nexrouter.roaming.rssi_mid_bf 2>/dev/null || echo -70)"
	rssi_far="$(uci -q get nexrouter.roaming.rssi_far_wall 2>/dev/null || echo -77)"
	rssi_high_2g="$(uci -q get nexrouter.roaming.rssi_high_2g 2>/dev/null || echo -60)"

	if [ "$enabled" != "1" ]; then
		sleep 10
		continue
	fi

	if_2g="$(discover_ap 2g)"
	if_5g="$(discover_ap 5g)"
	sync_rrm_neighbors "$if_2g" "$if_5g"

	therm_info="$(check_thermal_guard "$if_5g" "$if_2g")"
	rf_temp_c="$(printf '%s' "$therm_info" | cut -d'|' -f1)"
	therm_state="$(printf '%s' "$therm_info" | cut -d'|' -f2)"

	rx5="$( [ -n "$if_5g" ] && cat "/sys/class/net/$if_5g/statistics/rx_bytes" 2>/dev/null || echo 0 )"
	tx5="$( [ -n "$if_5g" ] && cat "/sys/class/net/$if_5g/statistics/tx_bytes" 2>/dev/null || echo 0 )"
	rx2="$( [ -n "$if_2g" ] && cat "/sys/class/net/$if_2g/statistics/rx_bytes" 2>/dev/null || echo 0 )"
	tx2="$( [ -n "$if_2g" ] && cat "/sys/class/net/$if_2g/statistics/tx_bytes" 2>/dev/null || echo 0 )"
	cur_bytes=$((rx5 + tx5 + rx2 + tx2))
	prev_bytes="$(cat "$PREV_BYTES_FILE" 2>/dev/null || echo "$cur_bytes")"
	printf '%s' "$cur_bytes" > "$PREV_BYTES_FILE"
	delta_bytes=$((cur_bytes - prev_bytes))
	[ "$delta_bytes" -lt 0 ] && delta_bytes=0
	tput_kbps=$((delta_bytes * 8 / (interval * 1000 + 1)))

	sta_json_list=""
	worst_rssi=-45
	avg_retry_pct=0
	sta_count=0

	for iface in $if_5g $if_2g; do
		[ -n "$iface" ] || continue
		band_label="5GHz"
		[ "$iface" = "$if_2g" ] && band_label="2.4GHz"

		sta_dump="$(iw dev "$iface" station dump 2>/dev/null)"
		[ -n "$sta_dump" ] || continue

		parsed_stas="$(printf '%s
' "$sta_dump" | awk '
			/^Station/ { if (mac != "") print mac "," sig "," txp "," txr "," tp; mac=$2; sig=-50; txp=1; txr=0; tp="0" }
			/signal avg:/ { sig=$3+0 }
			/tx packets:/ { txp=$3+0 }
			/tx retries:/ { txr=$3+0 }
			/expected throughput:/ { tp=$3; sub(/Mbps/, "", tp) }
			END { if (mac != "") print mac "," sig "," txp "," txr "," tp }
		')"

		for row in $parsed_stas; do
			mac="$(printf '%s' "$row" | cut -d, -f1)"
			sig="$(printf '%s' "$row" | cut -d, -f2)"
			txp="$(printf '%s' "$row" | cut -d, -f3)"
			txr="$(printf '%s' "$row" | cut -d, -f4)"
			tp="$(printf '%s' "$row" | cut -d, -f5)"
			[ -n "$mac" ] || continue

			[ "${txp:-0}" -le 0 ] && txp=1
			retry_pct=$((txr * 100 / (txp + txr)))
			[ "$sig" -lt "$worst_rssi" ] 2>/dev/null && worst_rssi="$sig"
			avg_retry_pct=$((avg_retry_pct + retry_pct))
			sta_count=$((sta_count + 1))

			regime="ULTRA_NEAR"
			weight=256
			action="64-MPDU+11K-AMSDU+Core1-L1"

			if [ "$band_label" = "5GHz" ]; then
				if [ "$sig" -le "$rssi_far" ] && [ "$retry_pct" -ge 30 ]; then
					regime="EXTREME_EDGE"
					weight=640
					action="802.11r/v-FastSteer-2.4G+MaxATF"
					nr_2g="$( [ -n "$if_2g" ] && ubus call "hostapd.$if_2g" rrm_nr_get_own 2>/dev/null | jq -r '.value[2] // empty' 2>/dev/null )"
					if [ -n "$nr_2g" ]; then
						ubus call "hostapd.$if_5g" bss_transition_request 							"{"addr":"$mac","disassociation_imminent":false,"disassociation_timer":0,"validity_period":30,"neighbors":["$nr_2g"],"abridged":1}" 2>/dev/null
					fi
				elif [ "$sig" -le "$rssi_mid" ]; then
					regime="FAR_WALLBREAKER"
					weight=512
					action="4x4-eBF/iBF+ATF-2x+CCA-98dBm"
				elif [ "$sig" -le "$rssi_near" ]; then
					regime="MID_BEAMFORM"
					weight=320
					action="4x4-eBF/iBF+24ms-AQL-NoRTS"
				fi
				update_sta_airtime_if_changed "$if_5g" "$mac" "$weight"
			else
				if [ "$sig" -ge "$rssi_high_2g" ]; then
					regime="NEAR_UPGRADE_5G"
					weight=256
					action="802.11r/v-FastUpgrade-5G-1733M"
					nr_5g="$( [ -n "$if_5g" ] && ubus call "hostapd.$if_5g" rrm_nr_get_own 2>/dev/null | jq -r '.value[2] // empty' 2>/dev/null )"
					if [ -n "$nr_5g" ]; then
						ubus call "hostapd.$if_2g" bss_transition_request 							"{"addr":"$mac","disassociation_imminent":false,"disassociation_timer":0,"validity_period":30,"neighbors":["$nr_5g"],"abridged":1}" 2>/dev/null
					fi
				elif [ "$sig" -le -75 ]; then
					regime="LONG_RANGE_2G"
					weight=512
					action="QPF4200-LNA+256QAM-CCA-98dBm"
				else
					regime="TURBOQAM_2G_400M"
					weight=320
					action="QPF4200-HT40-256QAM-400Mbps"
				fi
				update_sta_airtime_if_changed "$if_2g" "$mac" "$weight"
			fi

			sta_entry="{"mac":"$mac","band":"$band_label","rssi":$sig,"retry_pct":$retry_pct,"expected_mbps":${tp:-0},"regime":"$regime","airtime_weight":$weight,"ai_action":"$action"}"
			sta_json_list="${sta_json_list}${sta_json_list:+,}${sta_entry}"
		done
	done

	[ "$sta_count" -gt 0 ] && avg_retry_pct=$((avg_retry_pct / sta_count))

	if [ "$worst_rssi" -ge -62 ] 2>/dev/null; then
		OBSS_PD_MODE="SPATIAL_REUSE_AGGRESSIVE"
		CCA_ED_DBM=-68
	elif [ "$worst_rssi" -le -72 ] 2>/dev/null; then
		OBSS_PD_MODE="LONG_RANGE_SENSITIVITY"
		CCA_ED_DBM=-98
	else
		OBSS_PD_MODE="ADAPTIVE_BALANCED"
		CCA_ED_DBM=-82
	fi

	if [ "$ai_bandit" = "1" ]; then
		bandit_out="$(awk -v cur_arm="$ACTIVE_ARM" 		                  -v wrssi="$worst_rssi" 		                  -v retry="$avg_retry_pct" 		                  -v kbps="$tput_kbps" '
		BEGIN { FS="	"; OFS="	"; tot_pulls = 0 }
		{
			id[NR] = $1 + 0; name[NR] = $2; aql[NR] = $3 + 0; rts[NR] = $4 + 0
			pulls[NR] = $5 + 0; reward[NR] = $6 + 0
			tot_pulls += pulls[NR]
			n = NR
		}
		END {
			r_now = (100 - retry) * 800 + int(kbps / 15)
			for (i = 1; i <= n; i++) {
				if (id[i] == cur_arm) {
					pulls[i] += 1
					tot_pulls += 1
					reward[i] = int((reward[i] * 7 + r_now * 3) / 10)
				}
			}
			best_id = 0; best_score = -1
			for (i = 1; i <= n; i++) {
				ctx_bonus = 0
				if (wrssi >= -62 && id[i] == 0) ctx_bonus = 30000
				else if (wrssi < -62 && wrssi > -72 && id[i] == 1) ctx_bonus = 28000
				else if (wrssi <= -72 && wrssi > -78 && id[i] == 2) ctx_bonus = 28000
				else if ((wrssi <= -78 || retry >= 30) && id[i] == 3) ctx_bonus = 32000
				exp_term = int(2000 * sqrt(tot_pulls / (pulls[i] > 0 ? pulls[i] : 1)))
				score = reward[i] + ctx_bonus + exp_term
				if (score > best_score) {
					best_score = score; best_id = id[i]
					best_name = name[i]; best_aql = aql[i]; best_rts = rts[i]
				}
				printf "%d	%s	%d	%d	%d	%d
", id[i], name[i], aql[i], rts[i], pulls[i], reward[i] > "'"$BANDIT_STATE.new"'"
			}
			printf "%d|%s|%d|%d|%d
", best_id, best_name, best_aql, best_rts, best_score
		}' "$BANDIT_STATE" 2>/dev/null)"

		[ -s "$BANDIT_STATE.new" ] && mv -f "$BANDIT_STATE.new" "$BANDIT_STATE"

		if [ -n "$bandit_out" ]; then
			ACTIVE_ARM="$(printf '%s' "$bandit_out" | cut -d'|' -f1)"
			ACTIVE_ARM_NAME="$(printf '%s' "$bandit_out" | cut -d'|' -f2)"
			ACTIVE_AQL="$(printf '%s' "$bandit_out" | cut -d'|' -f3)"
			ACTIVE_RTS="$(printf '%s' "$bandit_out" | cut -d'|' -f4)"
			ACTIVE_SCORE="$(printf '%s' "$bandit_out" | cut -d'|' -f5)"
			apply_radio_arm_and_obss_pd "$ACTIVE_AQL" "$ACTIVE_RTS" "$CCA_ED_DBM"
		fi
	fi

	cat <<SEOF > "$STATE_FILE"
{
  "engine": "NexRouter v3.7 AI-RF, Gigabit Download & Edge-Triggered Thermal Controller",
  "status": "running",
  "timestamp": $(date +%s),
  "algorithm": "Edge-Triggered UCB1 Bandit + 24ms AQL Aggregation + Core 1 L1 Fastpath",
  "active_arm_id": ${ACTIVE_ARM:-0},
  "active_profile": "${ACTIVE_ARM_NAME:-PEAK_AGGREGATION_1733M}",
  "aql_txq_limit_us": ${ACTIVE_AQL:-5000},
  "rts_threshold": ${ACTIVE_RTS:-2347},
  "obss_pd_mode": "${OBSS_PD_MODE}",
  "cca_ed_threshold_dbm": ${CCA_ED_DBM:--82},
  "rf_temp_c": ${rf_temp_c:-52},
  "thermal_guard_state": "${therm_state:-FULL_POWER_26dBm}",
  "ucb1_score": ${ACTIVE_SCORE:-115000},
  "worst_rssi_dbm": ${worst_rssi:--50},
  "avg_retry_pct": ${avg_retry_pct:-0},
  "wifi6_backports": {
    "obss_pd_spatial_reuse": true,
    "virtual_time_airtime_fairness": true,
    "wnm_sleep_twt_proxy_arp": true,
    "mu_edca_wmm_prioritization": true,
    "wpa3_sae_80211r_fast_transition": true
  },
  "phy_capabilities": {
    "5ghz_max_phy_mbps": 1733,
    "5ghz_features": "4x4 VHT80 MCS9, 11454B MPDU, 24ms AQL 64-MPDU Burst, Core1 L1 Fastpath, 26 dBm iPA",
    "2ghz_max_phy_mbps": 400,
    "2ghz_features": "2x2 HT40 256-QAM TurboQAM, 2x Qorvo QPF4200 +5V FEMs (15.5dB LNA), -98 dBm CCA"
  },
  "dual_band_rrm_active": true,
  "stations": [${sta_json_list}]
}
SEOF

	sleep "${interval:-3}"
done
