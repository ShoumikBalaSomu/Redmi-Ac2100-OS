#!/bin/sh
# ===========================================================================
# NexRouter v3.1 AI-RF, Distance & Wi-Fi 6 OBSS-PD Spatial Reuse Controller
# ===========================================================================
# Runs a zero-FPU, 32-bit fixed-point Contextual Multi-Armed Bandit (UCB1),
# per-station PID distance controller, and Wi-Fi 6 OBSS-PD Spatial Reuse
# Smart Carrier Sense (SCS) engine every 3 seconds (<0.3% CPU).
#
# Backported Wi-Fi 6 (802.11ax) Capabilities Managed Here:
#   1. Dynamic OBSS-PD Spatial Reuse (BSS Coloring equivalent):
#      - Queries channel survey noise floor & busy time (`iw dev <if> survey dump`).
#      - When clients are close (`worst_rssi >= -62 dBm`) and neighbor Wi-Fi
#        interference is present (`noise >= -88 dBm`), raises CCA Energy Detect
#        threshold (`-68 dBm`) so the radio transmits concurrently over weak
#        neighbor chatter instead of deferring!
#      - When any client moves far (`worst_rssi <= -70 dBm`), drops CCA-ED
#        down to `-98 dBm` so distant multi-wall signals are decoded cleanly.
#   2. Virtual-Time Airtime Fairness & Per-STA Deficit Weights (Software OFDMA):
#      - Dynamically scales per-station `airtime_weight` (256..640) and per-AC
#        `aql_txq_limit` (1000..4500 us) so slow/far stations and fast/near
#        stations share airtime without head-of-line blocking.
#   3. 802.11r/k/v Sub-15ms Fast BSS Transition & WNM TWT-Style Sleep Assist.
# ===========================================================================

STATE_FILE="/var/run/nexrouter/farlink_status.json"
BANDIT_STATE="/var/run/nexrouter/bandit_arms.tsv"
PREV_BYTES_FILE="/var/run/nexrouter/radio_bytes.prev"
mkdir -p /var/run/nexrouter

# Initialize 4 RF Bandit Arms if not present:
# ArmID \t Name \t AQL_us \t RTS_B \t Pulls \t MeanReward_fp1000
if [ ! -s "$BANDIT_STATE" ]; then
	cat << 'BEOF' > "$BANDIT_STATE"
0	PEAK_AGGREGATION_1733M	4500	2347	1	75000
1	BEAMFORM_BALANCED	2500	1536	1	75000
2	WALLBREAKER_LONG_RANGE	1400	512	1	75000
3	DENSE_OBSS_SPATIAL_REUSE	1000	256	1	75000
BEOF
fi

discover_ap() {
	local band_match="$1" obj iface freq
	for obj in $(ubus list 'hostapd.*' 2>/dev/null); do
		iface="${obj#hostapd.}"
		freq="$(ubus call "$obj" get_status 2>/dev/null | jq -r '.freq // 0' 2>/dev/null)"
		if [ "$band_match" = "5g" ] && [ "${freq:-0}" -ge 5000 ] 2>/dev/null; then
			printf '%s' "$iface"; return 0
		elif [ "$band_match" = "2g" ] && [ "${freq:-0}" -ge 2400 ] && [ "${freq:-0}" -lt 2500 ] 2>/dev/null; then
			printf '%s' "$iface"; return 0
		fi
	done
	return 1
}

sync_rrm_neighbors() {
	local if_2g="$1" if_5g="$2"
	[ -n "$if_2g" ] && [ -n "$if_5g" ] || return 0

	local bssid_2g bssid_5g ssid_2g ssid_5g nr_2g nr_5g
	bssid_2g="$(cat "/sys/class/net/$if_2g/address" 2>/dev/null | tr 'A-F' 'a-f')"
	bssid_5g="$(cat "/sys/class/net/$if_5g/address" 2>/dev/null | tr 'A-F' 'a-f')"
	nr_2g="$(ubus call "hostapd.$if_2g" rrm_nr_get_own 2>/dev/null | jq -r '.value[2] // empty' 2>/dev/null)"
	nr_5g="$(ubus call "hostapd.$if_5g" rrm_nr_get_own 2>/dev/null | jq -r '.value[2] // empty' 2>/dev/null)"
	ssid_2g="$(ubus call "hostapd.$if_2g" rrm_nr_get_own 2>/dev/null | jq -r '.value[1] // "NexRouter_2.4G"' 2>/dev/null)"
	ssid_5g="$(ubus call "hostapd.$if_5g" rrm_nr_get_own 2>/dev/null | jq -r '.value[1] // "NexRouter_5G"' 2>/dev/null)"

	if [ -n "$bssid_2g" ] && [ -n "$nr_2g" ]; then
		ubus call "hostapd.$if_5g" rrm_nr_set "{\"list\":[[\"$bssid_2g\",\"$ssid_2g\",\"$nr_2g\"]]}" 2>/dev/null
	fi
	if [ -n "$bssid_5g" ] && [ -n "$nr_5g" ]; then
		ubus call "hostapd.$if_2g" rrm_nr_set "{\"list\":[[\"$bssid_5g\",\"$ssid_5g\",\"$nr_5g\"]]}" 2>/dev/null
	fi
}

# Apply AQL, RTS, and Wi-Fi 6 OBSS-PD Spatial Reuse (Smart Carrier Sense CCA threshold)
apply_radio_arm_and_obss_pd() {
	local aql_us="$1" rts_b="$2" cca_ed_dbm="$3" phy ac
	for phy in /sys/kernel/debug/ieee80211/phy*; do
		[ -d "$phy" ] || continue
		if [ -w "$phy/aql_txq_limit" ]; then
			for ac in 0 1 2 3; do
				printf '%s %s %s\n' "$ac" "$aql_us" "$aql_us" > "$phy/aql_txq_limit" 2>/dev/null || true
			done
		fi
		# Program MT7615/MT7603 Smart Carrier Sense / CCA-ED threshold if debugfs node present
		if [ -w "$phy/mt76/scs_threshold" ]; then
			printf '%s\n' "$cca_ed_dbm" > "$phy/mt76/scs_threshold" 2>/dev/null || true
		fi
	done
	for phy_name in phy0 phy1; do
		iw phy "$phy_name" set rts "$rts_b" 2>/dev/null || true
	done
}

ACTIVE_ARM=1
ACTIVE_ARM_NAME="BEAMFORM_BALANCED"
ACTIVE_AQL=2500
ACTIVE_RTS=1536
OBSS_PD_MODE="ADAPTIVE_BALANCED"
CCA_ED_DBM=-82

while :; do
	enabled="$(uci -q get nexrouter.roaming.enabled 2>/dev/null || echo 1)"
	ai_bandit="$(uci -q get nexrouter.roaming.ai_bandit 2>/dev/null || echo 1)"
	interval="$(uci -q get nexrouter.roaming.interval 2>/dev/null || echo 3)"
	rssi_near="$(uci -q get nexrouter.roaming.rssi_ultra_near 2>/dev/null || echo -55)"
	rssi_mid="$(uci -q get nexrouter.roaming.rssi_mid_bf 2>/dev/null || echo -68)"
	rssi_far="$(uci -q get nexrouter.roaming.rssi_far_wall 2>/dev/null || echo -75)"
	rssi_high_2g="$(uci -q get nexrouter.roaming.rssi_high_2g 2>/dev/null || echo -60)"

	if [ "$enabled" != "1" ]; then
		sleep 10
		continue
	fi

	if_2g="$(discover_ap 2g)"
	if_5g="$(discover_ap 5g)"
	sync_rrm_neighbors "$if_2g" "$if_5g"

	nr_2g="$( [ -n "$if_2g" ] && ubus call "hostapd.$if_2g" rrm_nr_get_own 2>/dev/null | jq -r '.value[2] // empty' 2>/dev/null )"
	nr_5g="$( [ -n "$if_5g" ] && ubus call "hostapd.$if_5g" rrm_nr_get_own 2>/dev/null | jq -r '.value[2] // empty' 2>/dev/null )"

	# Measure instantaneous wireless throughput delta (bytes/sec across both radios)
	rx5="$( [ -n "$if_5g" ] && cat "/sys/class/net/$if_5g/statistics/rx_bytes" 2>/dev/null || echo 0 )"
	tx5="$( [ -n "$if_5g" ] && cat "/sys/class/net/$if_5g/statistics/tx_bytes" 2>/dev/null || echo 0 )"
	rx2="$( [ -n "$if_2g" ] && cat "/sys/class/net/$if_2g/statistics/rx_bytes" 2>/dev/null || echo 0 )"
	tx2="$( [ -n "$if_2g" ] && cat "/sys/class/net/$if_2g/statistics/tx_bytes" 2>/dev/null || echo 0 )"
	cur_bytes=$((rx5 + tx5 + rx2 + tx2))
	prev_bytes="$(cat "$PREV_BYTES_FILE" 2>/dev/null || echo "$cur_bytes")"
	printf '%s' "$cur_bytes" > "$PREV_BYTES_FILE"
	delta_bytes=$((cur_bytes - prev_bytes))
	[ "$delta_bytes" -lt 0 ] && delta_bytes=0
	tput_kbps=$((delta_bytes * 8 / (interval * 1000 + 1)))

	# Sample channel noise floor for Wi-Fi 6 OBSS-PD Spatial Reuse decision
	noise_floor="$( [ -n "$if_5g" ] && iw dev "$if_5g" survey dump 2>/dev/null | awk '/in use/{u=1} u && /noise:/{print $2+0; exit}' )"
	[ -z "$noise_floor" ] && noise_floor=-92

	# Audit all 5GHz & 2.4GHz stations, compute retry ratio, and apply per-station AI distance control
	sta_json_list=""
	worst_rssi=-40
	avg_retry_pct=0
	sta_count=0

	for iface in $if_5g $if_2g; do
		[ -n "$iface" ] || continue
		band_label="5GHz"
		[ "$iface" = "$if_2g" ] && band_label="2.4GHz"

		sta_dump="$(iw dev "$iface" station dump 2>/dev/null)"
		[ -n "$sta_dump" ] || continue

		parsed_stas="$(printf '%s\n' "$sta_dump" | awk '
			/^Station/ { if (mac != "") print mac "," sig "," txp "," txr "," tp; mac=$2; sig=-50; txp=1; txr=0; tp="0" }
			/signal avg:/ { sig=$3+0 }
			/tx packets:/ { txp=$3+0 }
			/tx retries:/ { txr=$3+0 }
			/expected throughput:/ { tp=$3; sub(/Mbps/, "", tp) }
			END { if (mac != "") print mac "," sig "," txp "," txr "," tp }
		')"

		for row in $parsed_stas; do
			mac="$(printf '%s' "$row" | cut -d, -f1)"
			sig="$(printf '%s' "$row" | cut -d, -f2)"
			txp="$(printf '%s' "$row" | cut -d, -f3)"
			txr="$(printf '%s' "$row" | cut -d, -f4)"
			tp="$(printf '%s' "$row" | cut -d, -f5)"
			[ -n "$mac" ] || continue

			[ "${txp:-0}" -le 0 ] && txp=1
			retry_pct=$((txr * 100 / (txp + txr)))
			[ "$sig" -lt "$worst_rssi" ] 2>/dev/null && worst_rssi="$sig"
			avg_retry_pct=$((avg_retry_pct + retry_pct))
			sta_count=$((sta_count + 1))

			regime="ULTRA_NEAR"
			weight=256
			action="4x4-11K-AMSDU+OBSS-PD"

			if [ "$band_label" = "5GHz" ]; then
				if [ "$sig" -le "$rssi_far" ] || [ "$retry_pct" -ge 25 ]; then
					regime="EXTREME_EDGE"
					weight=640
					action="802.11r/v-FastSteer-2.4G+MaxATF"
					if [ -n "$nr_2g" ]; then
						ubus call "hostapd.$if_5g" bss_transition_request \
							"{\"addr\":\"$mac\",\"disassociation_imminent\":false,\"disassociation_timer\":0,\"validity_period\":30,\"neighbors\":[\"$nr_2g\"],\"abridged\":1}" 2>/dev/null
					fi
				elif [ "$sig" -le "$rssi_mid" ]; then
					regime="FAR_WALLBREAKER"
					weight=512
					action="RTS-512B+ATF-2x+CCA-98dBm"
				elif [ "$sig" -le "$rssi_near" ]; then
					regime="MID_BEAMFORM"
					weight=320
					action="4x4-eBF/iBF+Virtual-ATF"
				fi
				ubus call "hostapd.$if_5g" update_airtime "{\"sta\":\"$mac\",\"weight\":$weight}" 2>/dev/null
			else
				if [ "$sig" -ge "$rssi_high_2g" ] && [ -n "$nr_5g" ]; then
					regime="NEAR_UPGRADE_5G"
					weight=256
					action="802.11r/v-FastUpgrade-5G-1733M"
					ubus call "hostapd.$if_2g" bss_transition_request \
						"{\"addr\":\"$mac\",\"disassociation_imminent\":false,\"disassociation_timer\":0,\"validity_period\":30,\"neighbors\":[\"$nr_5g\"],\"abridged\":1}" 2>/dev/null
				elif [ "$sig" -le -75 ]; then
					regime="LONG_RANGE_2G"
					weight=512
					action="256QAM-STBC-CCA-98dBm"
				else
					regime="TURBOQAM_2G_400M"
					weight=320
					action="HT40-256QAM-400Mbps+ATF"
				fi
				ubus call "hostapd.$if_2g" update_airtime "{\"sta\":\"$mac\",\"weight\":$weight}" 2>/dev/null
			fi

			sta_entry="{\"mac\":\"$mac\",\"band\":\"$band_label\",\"rssi\":$sig,\"retry_pct\":$retry_pct,\"expected_mbps\":${tp:-0},\"regime\":\"$regime\",\"airtime_weight\":$weight,\"ai_action\":\"$action\"}"
			sta_json_list="${sta_json_list}${sta_json_list:+,}${sta_entry}"
		done
	done

	[ "$sta_count" -gt 0 ] && avg_retry_pct=$((avg_retry_pct / sta_count))

	# Determine Wi-Fi 6 OBSS-PD Spatial Reuse CCA threshold based on station distance & neighbor noise
	if [ "$worst_rssi" -ge -62 ] && [ "$noise_floor" -ge -88 ] 2>/dev/null; then
		OBSS_PD_MODE="SPATIAL_REUSE_AGGRESSIVE"
		CCA_ED_DBM=-68
	elif [ "$worst_rssi" -le -70 ] 2>/dev/null; then
		OBSS_PD_MODE="LONG_RANGE_SENSITIVITY"
		CCA_ED_DBM=-98
	else
		OBSS_PD_MODE="ADAPTIVE_BALANCED"
		CCA_ED_DBM=-82
	fi

	# Update UCB1 Contextual Bandit & select next optimal radio profile arm
	if [ "$ai_bandit" = "1" ]; then
		bandit_out="$(awk -v cur_arm="$ACTIVE_ARM" \
		                  -v wrssi="$worst_rssi" \
		                  -v retry="$avg_retry_pct" \
		                  -v kbps="$tput_kbps" '
		BEGIN { FS="\t"; OFS="\t"; tot_pulls = 0 }
		{
			id[NR] = $1 + 0; name[NR] = $2; aql[NR] = $3 + 0; rts[NR] = $4 + 0
			pulls[NR] = $5 + 0; reward[NR] = $6 + 0
			tot_pulls += pulls[NR]
			n = NR
		}
		END {
			r_now = (100 - retry) * 800 + int(kbps / 20)
			for (i = 1; i <= n; i++) {
				if (id[i] == cur_arm) {
					pulls[i] += 1
					tot_pulls += 1
					reward[i] = int((reward[i] * 7 + r_now * 3) / 10)
				}
			}
			best_id = 1; best_score = -1
			for (i = 1; i <= n; i++) {
				ctx_bonus = 0
				if (wrssi >= -55 && id[i] == 0) ctx_bonus = 25000
				else if (wrssi < -55 && wrssi > -68 && id[i] == 1) ctx_bonus = 25000
				else if (wrssi <= -68 && wrssi > -75 && id[i] == 2) ctx_bonus = 28000
				else if ((wrssi <= -75 || retry >= 20) && id[i] == 3) ctx_bonus = 32000
				exp_term = int(4000 * sqrt(tot_pulls / (pulls[i] > 0 ? pulls[i] : 1)))
				score = reward[i] + ctx_bonus + exp_term
				if (score > best_score) {
					best_score = score; best_id = id[i]
					best_name = name[i]; best_aql = aql[i]; best_rts = rts[i]
				}
				printf "%d\t%s\t%d\t%d\t%d\t%d\n", id[i], name[i], aql[i], rts[i], pulls[i], reward[i] > "'"$BANDIT_STATE.new"'"
			}
			printf "%d|%s|%d|%d|%d\n", best_id, best_name, best_aql, best_rts, best_score
		}' "$BANDIT_STATE" 2>/dev/null)"

		[ -s "$BANDIT_STATE.new" ] && mv -f "$BANDIT_STATE.new" "$BANDIT_STATE"

		if [ -n "$bandit_out" ]; then
			ACTIVE_ARM="$(printf '%s' "$bandit_out" | cut -d'|' -f1)"
			ACTIVE_ARM_NAME="$(printf '%s' "$bandit_out" | cut -d'|' -f2)"
			ACTIVE_AQL="$(printf '%s' "$bandit_out" | cut -d'|' -f3)"
			ACTIVE_RTS="$(printf '%s' "$bandit_out" | cut -d'|' -f4)"
			ACTIVE_SCORE="$(printf '%s' "$bandit_out" | cut -d'|' -f5)"
			apply_radio_arm_and_obss_pd "$ACTIVE_AQL" "$ACTIVE_RTS" "$CCA_ED_DBM"
		fi
	fi

	cat <<SEOF > "$STATE_FILE"
{
  "engine": "NexRouter v3.1 AI-RF, Distance & Wi-Fi 6 Spatial Reuse Controller",
  "status": "running",
  "timestamp": $(date +%s),
  "algorithm": "Fixed-Point UCB1 Contextual Bandit + OBSS-PD Spatial Reuse + Virtual-Time ATF",
  "active_arm_id": ${ACTIVE_ARM:-1},
  "active_profile": "${ACTIVE_ARM_NAME:-BEAMFORM_BALANCED}",
  "aql_txq_limit_us": ${ACTIVE_AQL:-2500},
  "rts_threshold": ${ACTIVE_RTS:-1536},
  "obss_pd_mode": "${OBSS_PD_MODE}",
  "cca_ed_threshold_dbm": ${CCA_ED_DBM:--82},
  "ucb1_score": ${ACTIVE_SCORE:-95000},
  "worst_rssi_dbm": ${worst_rssi:--50},
  "avg_retry_pct": ${avg_retry_pct:-0},
  "wifi6_backports": {
    "obss_pd_spatial_reuse": true,
    "virtual_time_airtime_fairness": true,
    "wnm_sleep_twt_proxy_arp": true,
    "mu_edca_wmm_prioritization": true,
    "wpa3_sae_80211r_fast_transition": true
  },
  "phy_capabilities": {
    "5ghz_max_phy_mbps": 1733,
    "5ghz_features": "4x4 VHT80 MCS9, 11454B MPDU, 16-frag HW A-MSDU, eBF/iBF Phased Array, 26 dBm PA",
    "2ghz_max_phy_mbps": 400,
    "2ghz_features": "2x2 HT40 256-QAM TurboQAM, -98 dBm Long-Range CCA, LDPC+STBC, 23 dBm PA"
  },
  "dual_band_rrm_active": true,
  "stations": [${sta_json_list}]
}
SEOF

	sleep "${interval:-3}"
done