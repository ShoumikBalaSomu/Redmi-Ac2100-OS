{
  "unauthenticated": {
    "description": "Passwordless LAN access for NexRouter /nex/ portal & LuCI File Manager",
    "read": {
      "ubus": {
        "nexrouter": [
          "*"
        ],
        "system": [
          "*"
        ],
        "network": [
          "*"
        ],
        "network.device": [
          "*"
        ],
        "network.interface": [
          "*"
        ],
        "network.interface.wan": [
          "*"
        ],
        "network.interface.lan": [
          "*"
        ],
        "network.wireless": [
          "*"
        ],
        "uci": [
          "*"
        ],
        "file": [
          "*"
        ],
        "iwinfo": [
          "*"
        ],
        "service": [
          "*"
        ],
        "log": [
          "*"
        ],
        "nlbwmon": [
          "*"
        ],
        "hostapd": [
          "*"
        ],
        "luci-rpc": [
          "*"
        ]
      },
      "file": {
        "/*": [
          "list",
          "read",
          "exec"
        ],
        "/": [
          "list",
          "read"
        ]
      },
      "cgi-io": [
        "download",
        "backup",
        "exec"
      ]
    },
    "write": {
      "ubus": {
        "nexrouter": [
          "*"
        ],
        "system": [
          "*"
        ],
        "network": [
          "*"
        ],
        "network.device": [
          "*"
        ],
        "network.wireless": [
          "*"
        ],
        "uci": [
          "*"
        ],
        "file": [
          "*"
        ],
        "service": [
          "*"
        ],
        "log": [
          "*"
        ],
        "nlbwmon": [
          "*"
        ]
      },
      "file": {
        "/*": [
          "write",
          "exec"
        ],
        "/": [
          "write"
        ]
      },
      "cgi-io": [
        "upload",
        "exec"
      ]
    }
  },
