# ── Node ──────────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
*.tgz
package-lock.json

# ── Web UI build output ───────────────────────────────────────────────────────
# dist/ is generated by `node webui/build.mjs` from webui/src. It is rebuilt at
# image-build time, so it is not tracked. Keep src/ — that is the real source.
webui/dist/

# ── Firmware build working tree ───────────────────────────────────────────────
# The OpenWrt Image Builder is large (~1-2 GB) and fully reproducible from the
# upstream URL recorded in build/build.sh. Never commit it.
build/.work/

# ── Build output ──────────────────────────────────────────────────────────────
# The flashable images. Reproducible from build/build.sh; large; binary.
out/
*.bin
*.img

# Exception: the three reference ROMs under analysis/raw are handled by their own
# .gitignore (they are downloaded, not built). Nothing else named *.bin is kept.

# ── Downloaded reference firmware ─────────────────────────────────────────────
# analysis/raw/.gitignore ignores everything in that directory. The upstream DTS
# copies under analysis/upstream ARE tracked — they are small text and are the
# evidence the docs cite.

# ── Analysis reports ──────────────────────────────────────────────────────────
# Generated JSON. Small, but reproducible from analysis/tools/fwscan.mjs, so not
# tracked. The findings they contain are transcribed into docs/02.
analysis/reports/

# ── Companion runtime data ────────────────────────────────────────────────────
# NetFlow captures, trained models and logs produced when running the collector.
companion/nexinsight/data/flows-*.jsonl
companion/nexinsight/data/summaries/
companion/nexinsight/data/models/
companion/nexinsight/data/*.log
companion/nexinsight/data/
!companion/nexinsight/data/labels.csv.example

# ── Editor / OS noise ─────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ── Local environment ─────────────────────────────────────────────────────────
.env
.env.local
*.local

# ── Mock server scratch ───────────────────────────────────────────────────────
webui/_mock.out
webui/_mock.err

# ── Extraction scratch & backups ──────────────────────────────────────────────
analysis/*_extracted/
build/custom_catwrt_*/
build/.work_repack/
build/mt76/
build/sdk/
build/snapshot/
packages_argon/
backups/
*.sha256
