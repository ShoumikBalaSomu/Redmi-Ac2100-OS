From: NexRouter Engineering <eng@nexrouter.io>
Date: Fri, 16 Oct 2026 12:10:00 +0600
Subject: [PATCH 100/109] mips: mt7621: dts: unlock 1.2Gbps TRGMII switch trunk, 0x4da8 EEPROM, EIP-93 HW crypto, HSDMA & No-Pause HoL Fix

Pushes the Xiaomi Redmi Router AC2100 (MT7621AT + MT7530 + MT7615N + MT7603EN)
Device Tree to its theoretical silicon limits:
  1. Upgrades `gmac0` <-> `switch0 port@6` from `rgmii` (1.0 Gbps @ 125 MHz) to
     `trgmii` (1.2 Gbps Turbo RGMII @ 150 MHz DDR), eliminating the 4-byte
     MediaTek DSA switch tag overhead bottleneck on `lan1`..`lan3` and providing
     2.2 Gbps combined internal Ethernet bandwidth (1.2G LAN + 1.0G WAN gmac1).
  2. Explicitly deletes `pause` from the `gmac0` and `port@6` `fixed-link` nodes
     (`/delete-property/ pause;`) so a 5 GHz Wi-Fi burst never emits 802.3x
     PAUSE frames that freeze wired LAN ports (`lan1`..`lan3`).
  3. Expands `eeprom_factory_8000` to full `0x4da8` (19,880 bytes) for MT7615N
     4x4 eBF/iBF and per-rate power calibration.
  4. Enables `crypto@1e004000` (Inside Secure EIP-93 hardware crypto engine),
     `gdma@2800` (16-ch General DMA), and `hsdma@7000` (High-Speed DMA).
  5. Disables PCIe L0s/L1 ASPM on `pcie0` (MT7615N) and `pcie1` (MT7603EN).

--- a/target/linux/ramips/dts/mt7621_xiaomi_router-ac2100.dtsi
+++ b/target/linux/ramips/dts/mt7621_xiaomi_router-ac2100.dtsi
@@ -5,33 +5,54 @@
 /* override EEPROM size to 0x4da8 for MT7615 */
 &eeprom_factory_8000 {
 	reg = <0x8000 0x4da8>;
 };
 
+&wdt {
+	status = "okay";
+};
+
+&crypto {
+	status = "okay";
+};
+
+&gdma {
+	status = "okay";
+};
+
+&hsdma {
+	status = "okay";
+};
+
 &pcie {
 	status = "okay";
+	linux,pci-probe-only = <0>;
 };
 
 &pcie0 {
 	wifi@0,0 {
 		compatible = "mediatek,mt76";
 		reg = <0x0000 0 0 0 0>;
 		nvmem-cells = <&eeprom_factory_8000>;
 		nvmem-cell-names = "eeprom";
 		ieee80211-freq-limit = <5000000 6000000>;
+		mediatek,disable-aspm;
 	};
 };
 
 &pcie1 {
 	wifi@0,0 {
 		compatible = "mediatek,mt76";
 		reg = <0x0000 0 0 0 0>;
 		nvmem-cells = <&eeprom_factory_0>;
 		nvmem-cell-names = "eeprom";
 		ieee80211-freq-limit = <2400000 2500000>;
+		mediatek,disable-aspm;
 	};
 };
 
 &gmac0 {
 	nvmem-cells = <&macaddr_factory_e000>;
 	nvmem-cell-names = "mac-address";
+	phy-mode = "trgmii";
+
+	fixed-link {
+		/delete-property/ pause;
+	};
 };
@@ -52,6 +73,14 @@
 &switch0 {
 	ports {
+		port@6 {
+			phy-mode = "trgmii";
+
+			fixed-link {
+				/delete-property/ pause;
+			};
+		};
+
 		port@2 {
 			status = "okay";
 			label = "lan1";
