--- a/arch/mips/ralink/mt7621.c
+++ b/arch/mips/ralink/mt7621.c
@@ -188,6 +188,12 @@ void __init ralink_of_remap(void)
 	if (!sysc || !memc)
 		panic("Failed to remap core resources");
+
+	/* Enable DDR3 burst prefetching on MT7621 memory controller for
+	 * high-bandwidth PCIe <-> Frame Engine DMA transfers */
+	__raw_writel(__raw_readl(memc + 0x04) | BIT(4), memc + 0x04);
 }
