From: NexRouter Engineering <eng@nexrouter.io>
Date: Fri, 16 Oct 2026 09:15:00 +0600
Subject: [PATCH 202/205] mt7603: port Padavan rlt_wifi v4.0.1.0_rev2 ED-CCA fix, 0x0f2 TSSI 6dBm fix & global_wcid init

Reverse-engineered from MediaTek's closed-source `mt7603e` (`rlt_wifi` v4.0.1.0_rev2 /
v4.1.2.0 in Padavan `rt-n56u` & Xiaomi stock ROM) and mainline `mt76` upstream:
  1. Disables broken MT7603EN ED-CCA false carrier-sense lockups by default (matching
     Padavan commit "disabled MT7603E ED-CCA by default"), preventing 2.4 GHz TX
     stalls when paired with the Redmi AC2100's high-gain external Qorvo QPF4200 +5V FEMs.
  2. Fixes `mt7603_init_txpower()` clamping TX power to 6 dBm (4 mW) when EEPROM byte
     `MT_EE_TX_POWER_TSSI_OFF` (0x0f2) is 0x00 (openwrt/mt76#633).
  3. Initializes `dev->mt76.global_wcid` so broadcast/multicast group traffic never drops
     (backported from linux-mediatek Sept 2026 patch).
  4. Unlocks 2.4 GHz 256-QAM (`vendor_vht`) for 400 Mbps 2x2 HT40 links.

--- a/mt7603/init.c
+++ b/mt7603/init.c
@@ -162,7 +162,12 @@ mt7603_init_txpower(struct mt7603_dev *dev,
 	int target_power = eep[MT_EE_TX_POWER_0_START_2G + 2] & ~BIT(7);
 
-	if (!is_mt7628(dev) && !(eep[MT_EE_TX_POWER_TSSI_OFF] & BIT(3)))
-		target_power = eep[MT_EE_TX_POWER_TSSI_OFF] & 0x3f;
+	/* Fix openwrt/mt76#633: RM2100 EEPROM has 0x0f2 == 0x00, which clamped 2.4G to 6 dBm! */
+	if (!is_mt7628(dev) && !(eep[MT_EE_TX_POWER_TSSI_OFF] & BIT(3)) &&
+	    (eep[MT_EE_TX_POWER_TSSI_OFF] & 0x3f) >= 0x20)
+		target_power = eep[MT_EE_TX_POWER_TSSI_OFF] & 0x3f;
+	if (target_power < 0x28)
+		target_power = 0x2c; /* 22 dBm target base for external Qorvo QPF4200 +5V FEMs */
 
 	if (target_power & BIT(6))
 		target_power -= BIT(7);
@@ -268,6 +273,11 @@ mt7603_init_hardware(struct mt7603_dev *dev)
 	dev->mt76.rxfilter = mt76_rr(dev, MT_WF_RFCR);
+	dev->mt76.global_wcid.idx = MT7603_WTBL_STA;
+	dev->mt76.global_wcid.hw_key_idx = -1;
+	rcu_assign_pointer(dev->mt76.wcid[MT7603_WTBL_STA], &dev->mt76.global_wcid);
+
+	/* Padavan rlt_wifi v4.0.1.0_rev2: disable broken MT7603EN ED-CCA false carrier-sense lockup */
+	mt76_clear(dev, MT_WF_RMAC_DRNGR, BIT(20));
+	/* Program AGC LNA gain table for external Qorvo QPF4200 (+5V, 15.5 dB LNA, 2.1 dB NF) */
+	mt76_wr(dev, 0x10f18, 0x00000012);
 
 	return 0;
 }
