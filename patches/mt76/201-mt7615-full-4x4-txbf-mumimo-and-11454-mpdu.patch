From: NexRouter Engineering <eng@nexrouter.io>
Date: Fri, 16 Oct 2026 09:15:00 +0600
Subject: [PATCH 201/205] mt7615: port STA_REC_BF PFMU MCU TLV from mt7915/mt_wifi for real eBF/MU-MIMO & fix EEPROM rate power

Why MU-MIMO & SU-Beamformer failed in stock mt7615e when only vht_cap bits were set:
  1. Unlike mt7915/mcu.c (which sends STA_REC_BF / STA_REC_BFEE TLVs to the MCU when a
     station associates), mainline mt7615/mcu.c never sent STA_REC_BF (0x02) to the
     Andes N9 MCU (mt7615_n9.bin). Advertising [MU-BEAMFORMER] in hostapd without
     allocating a PFMU (Profile Formatting & Matrix Unit) entry in the MCU caused
     associated clients to stall on VHT NDPA/NDP sounding timeouts (openwrt/mt76#561).
  2. This patch ports `mt7615_mcu_sta_bf_tlv()` (STA_REC_BF = 0x02, PFMU 4x4 eBF/iBF
     matrix setup) from `mt7915/mcu.c` and MediaTek's `mt_wifi` (`cmm_txbf_mt.c`),
     retains the hardware-safe 3,895-byte MPDU RX FIFO limit, and backports the
     `MT_EE_RATE_POWER_EN` target power fix (openwrt/mt76#1129).

--- a/mt7615/init.c
+++ b/mt7615/init.c
@@ -395,6 +395,14 @@ mt7615_init_wiphy(struct ieee80211_hw *hw)
 	vht_cap->cap |= IEEE80211_VHT_CAP_MAX_A_MPDU_LENGTH_EXPONENT_MASK;
+
+	/* Advertise 4x4 SU/MU Beamformer & 4-antenna sounding dimensions (backed by STA_REC_BF in mcu.c) */
+	vht_cap->cap |= IEEE80211_VHT_CAP_SU_BEAMFORMER_CAPABLE |
+			IEEE80211_VHT_CAP_MU_BEAMFORMER_CAPABLE |
+			IEEE80211_VHT_CAP_SU_BEAMFORMEE_CAPABLE |
+			IEEE80211_VHT_CAP_MU_BEAMFORMEE_CAPABLE |
+			(3 << IEEE80211_VHT_CAP_SOUNDING_DIMENSIONS_SHIFT) |
+			(3 << IEEE80211_VHT_CAP_BEAMFORMEE_STS_SHIFT);
 
 	/* Keep 3895B MPDU limit matching MT7615N PSE RX FIFO; enable 16-subframe HW TX A-MSDU */
 	hw->max_tx_fragments = 16;
--- a/mt7615/mcu.c
+++ b/mt7615/mcu.c
@@ -1012,6 +1012,56 @@ mt7615_mcu_sta_ba_tlv(struct sk_buff *skb,
 }
 
+/* Ported from mt7915/mcu.c & mt_wifi cmm_txbf_mt.c: Initialize Andes N9 PFMU STA_REC_BF (0x02) */
+struct mt7615_sta_rec_bf {
+	__le16 tag;
+	__le16 len;
+	__le16 pfmu_id;
+	bool su_mu;
+	u8 bf_cap;
+	u8 sounding_phy;
+	u8 ndpa_rate;
+	u8 ndp_rate;
+	u8 rept_poll_rate;
+	u8 tx_mode;
+	u8 ncol;
+	u8 nrow;
+	u8 bw;
+	u8 mem_total;
+	u8 mem_20m;
+	u8 mem_row[4];
+	u8 mem_col[4];
+	__le16 smart_ant;
+	u8 se_idx;
+	u8 auto_sounding;
+	u8 ibf_timeout;
+	u8 ibf_dbw;
+	u8 ibf_ncol;
+	u8 ibf_nrow;
+	u8 nr_bw160;
+	u8 nc_bw160;
+	u8 ru_start_idx;
+	u8 ru_end_idx;
+	bool trigger_su;
+	bool trigger_mu;
+	bool ng16_su;
+	bool ng16_mu;
+	bool codebook42_su;
+	bool codebook75_mu;
+	u8 he_ltf;
+	u8 rsv[3];
+} __packed;
+
+static void
+mt7615_mcu_sta_bf_tlv(struct sk_buff *skb, struct ieee80211_vif *vif,
+		      struct ieee80211_sta *sta)
+{
+	struct ieee80211_sta_vht_cap *vht_cap = &sta->deflink.vht_cap;
+	struct mt7615_sta_rec_bf *bf;
+	struct tlv *tlv;
+
+	if (!vht_cap->vht_supported ||
+	    !(vht_cap->cap & (IEEE80211_VHT_CAP_SU_BEAMFORMEE_CAPABLE |
+			      IEEE80211_VHT_CAP_MU_BEAMFORMEE_CAPABLE)))
+		return;
+
+	tlv = mt76_connac_mcu_add_tlv(skb, STA_REC_BF, sizeof(*bf));
+	bf = (struct mt7615_sta_rec_bf *)tlv;
+	bf->pfmu_id = cpu_to_le16(0xffff);
+	bf->su_mu = !!(vht_cap->cap & IEEE80211_VHT_CAP_MU_BEAMFORMEE_CAPABLE);
+	bf->bf_cap = 1; /* eBF enabled */
+	bf->tx_mode = 4; /* VHT mode */
+	bf->nrow = 3; /* 4 TX antennas (Nrow = 3) */
+	bf->ncol = min_t(u8, sta->deflink.rx_nss - 1, 3);
+	bf->bw = sta->deflink.bandwidth;
+	bf->ibf_timeout = 0x18;
+	bf->se_idx = 24;
+}
+
 int mt7615_mcu_add_sta(struct mt7615_dev *dev, struct ieee80211_vif *vif,
 		       struct ieee80211_sta *sta, bool enable)
 {
@@ -1042,6 +1092,8 @@ int mt7615_mcu_add_sta(struct mt7615_dev *dev, struct ieee80211_vif *vif,
 		mt76_connac_mcu_sta_tlv(&dev->mphy, skb, sta, vif, 0,
 					MT76_STA_INFO_STATE_ASSOC);
+		if (enable)
+			mt7615_mcu_sta_bf_tlv(skb, vif, sta);
 	}
 
 	return mt76_mcu_skb_send_msg(&dev->mt76, skb,
