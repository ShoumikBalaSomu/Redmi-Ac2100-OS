--- a/mt7615/mt7615.h
+++ b/mt7615/mt7615.h
@@ -24,8 +24,8 @@
 #define MT7615_MAX_WMM_SETS		4
 #define MT7615_WTBL_SIZE		128
 #define MT7615_WTBL_RESERVED		(MT7615_WTBL_SIZE - 1)
-#define MT7615_TX_RING_SIZE		1024
-#define MT7615_RX_RING_SIZE		512
+#define MT7615_TX_RING_SIZE		2048
+#define MT7615_RX_RING_SIZE		1024
 
 #define MT7615_FIRMWARE_CR4		"mediatek/mt7615_cr4.bin"
 #define MT7615_FIRMWARE_N9		"mediatek/mt7615_n9.bin"
--- a/mt7615/pci.c
+++ b/mt7615/pci.c
@@ -122,6 +122,10 @@ static int mt7615_pci_probe(struct pci_dev *pdev,
 	if (ret)
 		goto error;
 
+	/* Enable Threaded NAPI by default on MT7621 MIPS 1004Kc so PCIe RX
+	 * packet polling scales across VPE2/VPE3 without starving hard IRQs */
+	dev->mt76.napi_dev.threaded = 1;
+
 	return 0;
 error:
 	mt7615_pci_remove(pdev);
--- a/mt7603/pci.c
+++ b/mt7603/pci.c
@@ -68,6 +68,8 @@ mt7603_pci_probe(struct pci_dev *pdev, const struct pci_device_id *id)
 	if (ret)
 		goto error;
 
+	dev->mt76.napi_dev.threaded = 1;
+
 	return 0;
 error:
 	mt76_free_device(&dev->mt76);
